---
interface Props {
	label: string;
	caption: string;
}

const { label, caption } = Astro.props;
---

<!--
	Custodia's idea in one loop: two tools report on the same person, Custodia
	joins them by exact email and concludes. Pure CSS; without motion (or
	without CSS animation support) it shows the finished picture.
-->
<figure class="feature-shot custodia-story">
	<svg viewBox="0 0 360 300" role="img" aria-label={label}>
		<path class="cs-line cs-l1" pathLength="100" d="M72 150 C 104 150, 100 78, 132 78" />
		<path class="cs-line cs-l2" d="M72 150 C 104 150, 100 222, 132 222" />
		<path class="cs-line cs-l3" d="M236 78 H 256" />
		<path class="cs-line cs-l4" d="M236 222 H 256" />

		<g class="cs-person">
			<circle cx="48" cy="150" r="24" />
			<text x="48" y="155" text-anchor="middle">AM</text>
		</g>
		<g class="cs-name" aria-hidden="true">
			<rect x="2" y="134" width="92" height="32" rx="16" />
			<text x="48" y="154" text-anchor="middle">Alice Morgan</text>
		</g>

		<g class="cs-src cs-pam">
			<rect x="132" y="56" width="104" height="44" rx="8" />
			<text class="cs-seal" x="146" y="82">PA</text>
			<text x="172" y="82">CyberArk</text>
		</g>
		<g class="cs-src cs-sse">
			<rect x="132" y="200" width="104" height="44" rx="8" />
			<text class="cs-seal" x="146" y="226">SE</text>
			<text x="172" y="226">Netskope</text>
		</g>

		<g class="cs-rec cs-r1">
			<rect x="256" y="62" width="96" height="32" rx="6" />
			<text x="264" y="82">ACME-DEV-SVC</text>
		</g>
		<g class="cs-rec cs-r2">
			<rect x="256" y="206" width="96" height="32" rx="6" />
			<text x="264" y="226">no device</text>
		</g>

		<text class="cs-tag cs-t1" x="184" y="118" text-anchor="middle">exact email</text>
		<text class="cs-tag cs-t2" x="184" y="190" text-anchor="middle">exact email</text>

		<g class="cs-verdict">
			<rect x="64" y="262" width="232" height="30" rx="15" />
			<path d="M92 277 l7 -8 l7 8 l-7 8 z" />
			<text x="116" y="282">Gap · rule CONN-001 v1</text>
		</g>
	</svg>
	<figcaption>{caption}</figcaption>
</figure>

<style>
	.custodia-story {
		max-width: 24rem;
		width: 100%;
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--border);
		border-radius: 0.9rem;
		background: oklch(0.13 0.006 260);
		font: 600 11px/1 var(--font-mono, ui-monospace, monospace);
	}

	text {
		fill: var(--fg-soft);
	}

	.cs-line {
		fill: none;
		stroke: var(--fg-muted);
		stroke-width: 1.5;
	}

	.cs-l1 {
		stroke: oklch(0.72 0.12 290);
	}

	.cs-l2 {
		stroke: oklch(0.74 0.13 350);
		stroke-dasharray: 2 5;
		stroke-linecap: round;
	}

	.cs-l3 {
		stroke: oklch(0.72 0.12 290);
	}

	.cs-l4 {
		stroke: oklch(0.74 0.13 350);
		stroke-dasharray: 2 5;
	}

	.cs-name {
		display: none;
	}

	.cs-name rect {
		fill: oklch(0.19 0.007 260);
		stroke: var(--fg-soft);
		stroke-width: 1.5;
		transform-box: fill-box;
		transform-origin: center;
	}

	.cs-person circle {
		fill: oklch(0.19 0.007 260);
		stroke: var(--fg-soft);
		stroke-width: 1.5;
	}

	.cs-src rect {
		fill: oklch(0.19 0.007 260);
		stroke-width: 1.5;
	}

	.cs-pam rect {
		stroke: oklch(0.72 0.12 290);
	}

	.cs-sse rect {
		stroke: oklch(0.74 0.13 350);
	}

	.cs-seal {
		fill: var(--fg-muted);
		font-size: 9px;
	}

	.cs-rec rect {
		fill: none;
		stroke: var(--border);
	}

	.cs-r2 rect {
		stroke-dasharray: 3 3;
		stroke: var(--fg-muted);
	}

	.cs-r1 text,
	.cs-r2 text {
		font-size: 9.5px;
		fill: var(--fg-muted);
	}

	.cs-tag {
		font-size: 8.5px;
		fill: var(--fg-muted);
		font-weight: 400;
	}

	.cs-verdict rect {
		fill: oklch(0.76 0.14 25 / 0.14);
		stroke: oklch(0.76 0.14 25);
	}

	.cs-verdict path {
		fill: oklch(0.76 0.14 25);
	}

	.cs-verdict text {
		fill: oklch(0.86 0.1 25);
	}

	@media (prefers-reduced-motion: no-preference) {
		.cs-name {
			display: block;
			animation: cs-name 10s infinite;
		}
		.cs-name rect {
			animation: cs-pill 10s infinite;
		}
		.cs-person {
			animation: cs-am 10s infinite;
		}
		.cs-line {
			animation: cs-fade-a 10s infinite;
		}
		.cs-l1 {
			stroke-dasharray: 100;
			animation-name: cs-draw;
		}
		.cs-src,
		.cs-rec,
		.cs-tag {
			animation: cs-fade-a 10s infinite;
		}
		.cs-rec {
			animation-name: cs-fade-b;
		}
		.cs-tag {
			animation-name: cs-fade-b;
		}
		.cs-verdict {
			animation: cs-verdict 10s infinite;
		}
	}

	@keyframes cs-draw {
		0%,
		28% {
			stroke-dashoffset: 100;
			opacity: 1;
		}
		44%,
		90% {
			stroke-dashoffset: 0;
			opacity: 1;
		}
		100% {
			stroke-dashoffset: 0;
			opacity: 0;
		}
	}

	@keyframes cs-fade-a {
		0%,
		26% {
			opacity: 0;
		}
		36%,
		90% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	@keyframes cs-fade-b {
		0%,
		46% {
			opacity: 0;
		}
		56%,
		90% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	@keyframes cs-verdict {
		0%,
		66% {
			opacity: 0;
			transform: translateY(6px);
		}
		76%,
		90% {
			opacity: 1;
			transform: translateY(0);
		}
		100% {
			opacity: 0;
		}
	}

	@keyframes cs-name {
		0%,
		14% {
			opacity: 1;
		}
		24%,
		100% {
			opacity: 0;
		}
	}

	@keyframes cs-pill {
		0%,
		14% {
			transform: scaleX(1);
		}
		24%,
		100% {
			transform: scaleX(0.52);
		}
	}

	@keyframes cs-am {
		0%,
		16% {
			opacity: 0;
		}
		26%,
		90% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
</style>
