---
import { Image } from "astro:assets";
import DecisionDemo from "./DecisionDemo.astro";
import type { Content } from "../data/content";
import switchboardPasskeys from "../assets/projects/switchboard-passkeys.png";

interface Props {
	projects: Content["projects"];
	labels: Content["showcase"];
	stackLabel: string;
}

const { projects, labels, stackLabel } = Astro.props;
const images = { "switchboard-passkeys": switchboardPasskeys };
const id = (title: string) => `project-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<!--
	One project at a time, chosen from tabs or advancing on its own. Without
	JavaScript the tabs stay hidden and every project is shown, one after
	another. The script follows the ARIA tabs pattern and stops rotating for
	good once the visitor picks a tab.
-->
<div class="showcase" data-showcase data-reveal data-pause={labels.pause} data-play={labels.play}>
	<div class="showcase-bar" hidden>
		<div class="showcase-tabs" role="tablist" aria-label={labels.label}>
			{
				projects.map((project, i) => (
					<button
						type="button"
						role="tab"
						id={`${id(project.title)}-tab`}
						aria-controls={id(project.title)}
						aria-selected={i === 0 ? "true" : "false"}
						tabindex={i === 0 ? 0 : -1}
					>
						<span>{project.title}</span>
						<span class="tab-progress" aria-hidden="true"></span>
					</button>
				))
			}
		</div>
		<button type="button" class="showcase-toggle" aria-pressed="false">{labels.pause}</button>
	</div>

	{
		projects.map((project) => (
			<div class="feature" id={id(project.title)} role="tabpanel" aria-labelledby={`${id(project.title)}-tab`}>
				<div class="feature-copy">
					<div class="badges">
						<span class="badge badge-stage">{project.stage}</span>
						<span class="badge">{project.type}</span>
					</div>
					<h3>{project.title}</h3>
					<p class="feature-subtitle">{project.subtitle}</p>
					<dl class="points">
						{project.featured.points.map((point) => (
							<div>
								<dt>{point.label}</dt>
								<dd>{point.text}</dd>
							</div>
						))}
					</dl>
					{project.featured.demo && <DecisionDemo demo={project.featured.demo} />}
					<ul class="tags" aria-label={stackLabel}>
						{project.tags.map((tag) => <li>{tag}</li>)}
					</ul>
					<p class="availability">{project.availability}</p>
					{project.href && (
						<a class="text-link" href={project.href}>
							{project.linkLabel}
							<span aria-hidden="true"> →</span>
						</a>
					)}
				</div>
				{project.featured.image ? (
					<figure class="feature-shot">
						<Image
							src={images[project.featured.image]}
							alt={project.featured.imageAlt ?? ""}
							widths={[320, 460, 640]}
							sizes="(min-width: 64rem) 22rem, 80vw"
							loading="lazy"
						/>
						<figcaption>{project.featured.caption}</figcaption>
					</figure>
				) : (
					<div class="feature-soon">
						<span class="lamp" data-lamp="stepup" aria-hidden="true" />
						<p class="feature-soon-title">{project.title}</p>
						<p>{project.featured.comingSoon}</p>
					</div>
				)}
			</div>
		))
	}
</div>

<script>
	const ROTATE = 12000;

	for (const showcase of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
		const bar = showcase.querySelector<HTMLElement>(".showcase-bar")!;
		const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls")!)!);
		const toggle = showcase.querySelector<HTMLButtonElement>(".showcase-toggle")!;
		const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		let current = 0;
		let timer = 0;
		// stopped: the visitor chose a tab or pressed pause. The others hold
		// the rotation only while they last: pointer or focus inside (someone
		// is reading), or the showcase off screen.
		let stopped = still;
		let pointerIn = false;
		let focusIn = false;
		let offscreen = true;

		const running = () => !stopped && !pointerIn && !focusIn && !offscreen;

		const select = (index: number, focus = false) => {
			current = (index + tabs.length) % tabs.length;
			tabs.forEach((tab, i) => {
				const on = i === current;
				tab.setAttribute("aria-selected", String(on));
				tab.tabIndex = on ? 0 : -1;
				panels[i].hidden = !on;
			});
			if (focus) tabs[current].focus();
			schedule();
		};

		const schedule = () => {
			clearTimeout(timer);
			showcase.classList.toggle("is-rotating", running());
			// Restart the progress bar on the selected tab.
			for (const tab of tabs) tab.classList.remove("is-counting");
			if (!running()) return;
			void tabs[current].offsetWidth;
			tabs[current].classList.add("is-counting");
			timer = window.setTimeout(() => select(current + 1), ROTATE);
		};

		const stop = () => {
			stopped = true;
			toggle.textContent = showcase.dataset.play!;
			toggle.setAttribute("aria-pressed", "true");
			schedule();
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener("click", () => {
				stop();
				select(i);
			});
			tab.addEventListener("keydown", (event) => {
				const moves: Record<string, number> = { ArrowRight: current + 1, ArrowLeft: current - 1, Home: 0, End: tabs.length - 1 };
				if (!(event.key in moves)) return;
				event.preventDefault();
				stop();
				select(moves[event.key], true);
			});
		});

		toggle.addEventListener("click", () => {
			if (stopped) {
				stopped = false;
				toggle.textContent = showcase.dataset.pause!;
				toggle.setAttribute("aria-pressed", "false");
				schedule();
			} else {
				stop();
			}
		});
		if (still) {
			toggle.hidden = true;
		}

		showcase.addEventListener("pointerenter", () => {
			pointerIn = true;
			schedule();
		});
		showcase.addEventListener("pointerleave", () => {
			pointerIn = false;
			schedule();
		});
		showcase.addEventListener("focusin", () => {
			focusIn = true;
			schedule();
		});
		showcase.addEventListener("focusout", (event) => {
			if (showcase.contains(event.relatedTarget as Node)) return;
			focusIn = false;
			schedule();
		});
		new IntersectionObserver(([entry]) => {
			offscreen = !entry.isIntersecting;
			schedule();
		}, { threshold: 0.4 }).observe(showcase);

		bar.hidden = false;
		showcase.classList.add("is-tabbed");
		select(0);
	}
</script>
