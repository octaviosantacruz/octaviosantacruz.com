---
import ProjectScene from "./ProjectScene.astro";
import type { Content } from "../data/content";
import type { Locale } from "../i18n/translations";

interface Props {
	projects: Content["projects"];
	labels: Content["showcase"];
	stackLabel: string;
	locale: Locale;
}

const { projects, labels, stackLabel, locale } = Astro.props;
---

<!-- All projects remain readable without JavaScript. Selection is deliberate;
     only the explanatory scenes play, never the project being read. -->
<div class="showcase" data-showcase data-reveal>
	<div class="showcase-bar" hidden>
		<div class="showcase-tabs" role="tablist" aria-label={labels.label}>
			{projects.map((project, i) => (
				<button type="button" role="tab" id={`project-${project.key}-tab`}
					aria-controls={`project-${project.key}`} aria-selected={i === 0 ? "true" : "false"}
					tabindex={i === 0 ? 0 : -1}>{project.title}</button>
			))}
		</div>
	</div>
	{projects.map(project => (
		<div class="feature" id={`project-${project.key}`} role="tabpanel" aria-labelledby={`project-${project.key}-tab`}>
			<div class="feature-main">
				<div class="feature-copy">
					<p class="feature-stage" data-status={project.status}>{project.stage}</p>
					<h3>{project.title}</h3>
					<p class="feature-subtitle">{project.subtitle}</p>
					<p class="feature-intro">{project.body}</p>
					<a class="text-link" href={project.href}>{project.linkLabel}<span aria-hidden="true"> ↗</span></a>
					{project.demo && <a class="text-link" href={project.demo.href}>{project.demo.label}<span aria-hidden="true"> ↗</span></a>}
					<ul class="tags tags-quiet" aria-label={stackLabel}>{project.tags.map(tag => <li>{tag}</li>)}</ul>
				</div>
				<ProjectScene kind={project.key} locale={locale} />
			</div>
			<dl class="feature-checkpoint">
				<div><dt>{labels.today}</dt><dd>{project.today}</dd></div>
				<div><dt>{labels.next}</dt><dd>{project.next}</dd></div>
			</dl>
		</div>
	))}
</div>

<script>
	for (const showcase of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
		const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = tabs.map(tab => document.getElementById(tab.getAttribute("aria-controls")!)!);
		let current = 0;
		const select = (index: number, focus = false) => {
			current = (index + tabs.length) % tabs.length;
			tabs.forEach((tab, i) => {
				tab.setAttribute("aria-selected", String(i === current));
				tab.tabIndex = i === current ? 0 : -1;
				panels[i].hidden = i !== current;
			});
			if (focus) tabs[current].focus();
		};
		tabs.forEach((tab, i) => {
			tab.addEventListener("click", () => select(i));
			tab.addEventListener("keydown", event => {
				const moves: Record<string, number> = { ArrowRight: current + 1, ArrowLeft: current - 1, Home: 0, End: tabs.length - 1 };
				if (!(event.key in moves)) return;
				event.preventDefault();
				select(moves[event.key], true);
			});
		});
		showcase.querySelector<HTMLElement>(".showcase-bar")!.hidden = false;
		showcase.classList.add("is-tabbed");
		select(0);
	}
</script>
