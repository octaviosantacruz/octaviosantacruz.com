---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 48 48"
	fill="none"
	stroke="currentColor"
	stroke-width="2.5"
	stroke-linecap="square"
	stroke-linejoin="miter"
	aria-hidden="true"
	focusable="false"
>
	<path d="M24 5 L43 40" />
	<path d="M43 40 L5 40" />
	<path d="M5 40 L24 5" />
	<path d="M24 17 L34.5 36.5" />
	<path d="M17 24.5 L31 24.5" />
</svg>
