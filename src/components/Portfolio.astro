---

<a class="skip-link" href="#contenido">{t.skipLink}</a>

<div class="layout">
	<header class="sidebar">
		<div class="sidebar-inner">
			<p class="kicker">{content.kicker}</p>
			<h1 class="name-sign" aria-label={PERSON.fullName}>
				{
					nameLines.map((line) => (
						<span class="name-line">
							{line.map((character, index) => <span style={`--i: ${index}`} aria-hidden="true">{character}</span>)}
						</span>
					))
				}
			</h1>
			<p class="role">{PERSON.jobTitle}</p>
			<p class="intro">{content.intro}</p>
			<p class="location">{t.location}</p>
			<p class="status">
				<span aria-hidden="true"></span>
				{content.status}
			</p>

			<nav aria-label={t.navLabel}>
				<ul>
					{
						NAV_SECTIONS.map((section) => (
							<li>
								<a href={section.href} data-nav-link>
									<span class="nav-line" aria-hidden="true" />
									{t.nav[section.key]}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<LanguageSwitcher />
		</div>
	</header>

	<main class="content">
		<div id="contenido">
			<section id="sobre-mi" aria-labelledby="sobre-mi-heading" class="reveal">
				<h2 id="sobre-mi-heading">
					<span class="section-num" aria-hidden="true">{t.sections.sobreMi.num}</span>{
						t.sections.sobreMi.title
					}
				</h2>
				<div class="copy">
					{content.about.map((paragraph) => <p>{paragraph}</p>)}
				</div>
				<ul class="competency-list" aria-label="Core competencies">
					{content.competencies.map((competency) => <li>{competency}</li>)}
				</ul>
			</section>

			<section id="experiencia" aria-labelledby="experiencia-heading" class="reveal">
				<h2 id="experiencia-heading">
					<span class="section-num" aria-hidden="true">{t.sections.experiencia.num}</span>{
						t.sections.experiencia.title
					}
				</h2>
				<div class="timeline-list">
					{
						content.experience.map((role) => (
							<article class="timeline-item">
								<p class="meta">{role.period}</p>
								<div>
									<h3>{role.title}</h3>
									<p class="item-subtitle">{role.company} / {role.location}</p>
									<ul class="detail-list">
										{role.bullets.map((bullet) => <li>{bullet}</li>)}
									</ul>
									<ul class="tag-list" aria-label="Stack">
										{role.tags.map((tag) => <li>{tag}</li>)}
									</ul>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section id="certificaciones" aria-labelledby="certificaciones-heading" class="reveal">
				<h2 id="certificaciones-heading">
					<span class="section-num" aria-hidden="true">{t.sections.certificaciones.num}</span>{
						t.sections.certificaciones.title
					}
				</h2>
				<div class="record-list">
					{
						content.certifications.map((certification) => (
							<article class="record">
								<h3>{certification.title}</h3>
								<p>{certification.detail}</p>
							</article>
						))
					}
				</div>
			</section>

			<section id="proyectos" aria-labelledby="proyectos-heading" class="reveal">
				<h2 id="proyectos-heading">
					<span class="section-num" aria-hidden="true">{t.sections.proyectos.num}</span>{
						t.sections.proyectos.title
					}
				</h2>
				<div class="project-list">
					{
						content.projects.map((project) => (
							<article class="project-card">
								<h3>{project.title}</h3>
								<p class="meta">{project.meta}</p>
								<p>{project.body}</p>
							</article>
						))
					}
				</div>
			</section>

			<section id="contacto" aria-labelledby="contacto-heading" class="reveal">
				<h2 id="contacto-heading">
					<span class="section-num" aria-hidden="true">{t.sections.contacto.num}</span>{
						t.sections.contacto.title
					}
				</h2>
				<article class="record education-record">
					<h3>{content.education.title}</h3>
					<p>{content.education.detail}</p>
				</article>
				<div class="copy contact-copy">
					<p>{content.contact.body}</p>
				</div>
				<ul class="contact-list" aria-label="Contact links">
					{content.contact.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</section>
		</div>

		<footer>
			<p>&copy; {new Date().getFullYear()} {SITE.name}</p>
		</footer>
	</main>
</div>

<script>
	import "../scripts/scroll-spy";
</script>
