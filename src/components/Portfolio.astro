			},
		],
		education: {
			title: "B.Eng. Computer Science",
			detail:
				"Taiwan-Paraguay Polytechnic University (UPTP), Asuncion. Completed 15 months of full-time coursework in Taiwan through a merit-based academic exchange.",
		},
		contact: {
			body: "Feel free to contact me — always open to helping, collaborating, or participating in security projects.",
			lead: "You can find me on:",
			links: [
				{ label: "Email", href: "mailto:octavio.santacruz3@gmail.com", icon: "email" },
				{ label: "LinkedIn", href: "https://linkedin.com/in/octaviosantacruz", icon: "linkedin" },
				{ label: "GitHub", href: "https://github.com/octaviosantacruz", icon: "github" },
			],
		},
	},
	es: {
		kicker: "Portfolio / Seguridad Operacional",
		intro:
			"Ingeniero en ciberseguridad enfocado en operaciones de seguridad, identidad, accesos privilegiados y proteccion de datos.",
		status: "Abierto a relocation y roles remotos",
		about: [
			"Trabajo entre operaciones de seguridad, accesos privilegiados, proteccion de datos y gestion de vulnerabilidades, combinando pruebas ofensivas con ingenieria defensiva.",
			"Mi experiencia reciente incluye implementaciones empresariales en mas de 40 companias: CyberArk PAM y PSM, descubrimiento de datos con BigID, gobierno DLP con Netskope, remediacion de vulnerabilidades y automatizacion de seguridad.",
		],
		competencies: [
			"Security Operations",
			"Privileged Access Management",
			"Identity & Access Management",
			"Data Protection",
			"Gestion de Vulnerabilidades",
			"Automatizacion de Seguridad",
			"Pentesting Interno",
			"MITRE ATT&CK",
		],
		metrics: [
			{ value: "40+", label: "companias cubiertas por implementaciones de seguridad empresarial" },
			{ value: "20+", label: "companias incorporadas a gobierno CyberArk PSM" },
			{ value: "5+", label: "flujos de operaciones de seguridad automatizados" },
		],
		experience: [
			{
				period: "Sep 2025 - Actualidad",
				title: "Security Operations Analyst",
				company: "ITTI - Grupo Vazquez",
				location: "Asuncion, Paraguay",
				bullets: [
					"Lidere la reimplementacion end-to-end de CyberArk PAM en mas de 40 companias, migrando cuentas nominales desde Privilege Cloud hacia Secure Infrastructure Access y mejorando la utilizacion de licencias.",
					"Desplegue CyberArk PSM en mas de 20 companias, habilitando grabacion centralizada de sesiones y gobierno de accesos privilegiados a escala empresarial.",
					"Implemente BigID para descubrimiento y clasificacion de datos sensibles en multiples entornos, apoyando gobierno de datos alineado a GDPR.",
					"Ajuste politicas DLP de Netskope por unidad de negocio para mejorar precision de deteccion y reducir falsos positivos.",
					"Construí flujos de analitica de comportamiento con Netskope y BigID para detectar patrones anomalos de acceso a datos en investigaciones internas de fraude.",
				],
				tags: ["CyberArk", "BigID", "Netskope", "PAM", "DLP"],
			},
			{
				period: "May 2024 - Sep 2025",
				title: "Information Security Analyst",
				company: "Personal Paraguay",
				location: "Asuncion, Paraguay",
				bullets: [
					"Lidere pentesting interno y coordine remediacion de vulnerabilidades en mas de 40 servidores productivos.",
					"Disene un proceso estructurado de gestion de vulnerabilidades integrado con inventario de activos y controles IAM.",
					"Automatice mas de 5 tareas recurrentes de operaciones de seguridad con Ansible y scripts propios, reduciendo esfuerzo manual del equipo.",
				],
				tags: ["Pentesting", "Vulnerability Management", "Ansible", "IAM"],
			},
			{
				period: "Jul 2023 - May 2024",
				title: "Information Security Analyst",
				company: "NEST Security",
				location: "Asuncion, Paraguay",
				bullets: [
					"Promovido de intern a analista full-time tras entregar evaluaciones de vulnerabilidades para ejercicios red-team y mejoras de controles defensivos.",
				],
				tags: ["Vulnerability Assessment", "Red Team Support"],
			},
		],
		certifications: [
			{ title: "Netskope Accredited SSE Administrator", detail: "Netskope", href: "https://verify.skilljar.com/c/udnku33wxk5e" },
			{ title: "Netskope Administrator Accreditation", detail: "Netskope", href: "https://verify.skilljar.com/c/rxx37fvsvrra" },
			{ title: "BigID Fundamentals - Core 4 Series", detail: "BigID University", href: "https://university.bigid.com/student/award/nSnhLNrTkAcoAwUbbQcCvt5q" },
			{ title: "Nessus Fundamentals", detail: "Tenable", note: "Expirada el 17 ene 2026", href: "https://nessusfundamentals.tenable.com/528ba68c-841f-4e90-babf-7bbff58bfaea" },
			{ title: "Privileged Access Management with CyberArk", detail: "Udemy", href: "https://www.udemy.com/certificate/UC-ed99a7b1-be02-4a5a-a85b-95c75fdfc24b/" },
			{ title: "Junior Cybersecurity Analyst Career Path", detail: "Cisco / Credly", href: "https://www.credly.com/badges/6e52ad96-c457-438f-ba54-594f4f565ac6" },
		],
		projects: [
			{
				title: "Sigea Scan",
				type: "Open source / repo to be updated",
				meta: "Security engineering / Plataforma de gestion de vulnerabilidades / 2025 - Actualidad",
				body:
					"Desarrollo una plataforma on-premise de escaneo y gestion de vulnerabilidades pensada para simplificar despliegues, normalizar hallazgos y hacer evaluaciones de seguridad mas accesibles para organizaciones pequenas.",
				tags: ["Python", "Go", "Cloudflare", "Docker"],
			},
			{
				title: "MagicLink",
				type: "Open source / repo to be updated",
				subtitle: "Servicio zero-knowledge para compartir secretos de un solo uso",
				meta: "Security engineering / Plataforma de secret sharing / 2026 - Actualidad",
				body:
