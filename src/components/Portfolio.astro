		education: {
			title: "B.Eng. Computer Science",
			detail:
				"Universidad Politecnica Taiwan-Paraguay (UPTP), Asuncion. Complete 15 meses de cursado full-time en Taiwan mediante un intercambio academico por merito.",
		},
		contact: {
			body: "No dudes en contactarme — siempre abierto a ayudar, colaborar o participar en proyectos de seguridad.",
			lead: "Podés encontrarme en:",
			links: [
				{ label: "Email", href: "mailto:octavio.santacruz3@gmail.com", icon: "email" },
				{ label: "LinkedIn", href: "https://linkedin.com/in/octaviosantacruz", icon: "linkedin" },
				{ label: "GitHub", href: "https://github.com/octaviosantacruz", icon: "github" },
			],
		},
	},
}[locale];
---

<a class="skip-link" href="#contenido">{t.skipLink}</a>

<div class="layout">
	<header class="sidebar">
		<div class="sidebar-inner">
			<p class="kicker">{content.kicker}</p>
			<h1 class="name-sign" aria-label={PERSON.fullName}>
				{
					nameLines.map((line) => (
						<span class="name-line">
							{line.map((character, index) => <span style={`--i: ${index}`} aria-hidden="true">{character}</span>)}
						</span>
					))
				}
			</h1>
			<p class="role">{PERSON.jobTitle}</p>
			<p class="intro">{content.intro}</p>
			<p class="location">{t.location}</p>
			<p class="status">
				<span aria-hidden="true"></span>
				{content.status}
			</p>

			<nav aria-label={t.navLabel}>
				<ul>
					{
						NAV_SECTIONS.map((section) => (
							<li>
								<a href={section.href} data-nav-link>
									<span class="nav-line" aria-hidden="true" />
									{t.nav[section.key]}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<LanguageSwitcher />
		</div>
	</header>

	<main class="content">
		<div id="contenido">
			<section id="sobre-mi" aria-labelledby="sobre-mi-heading" class="reveal">
				<h2 id="sobre-mi-heading">
					<span class="section-num" aria-hidden="true">{t.sections.sobreMi.num}</span>{
						t.sections.sobreMi.title
					}
				</h2>
				<div class="copy">
					{content.about.map((paragraph) => <p>{paragraph}</p>)}
				</div>
				<div class="metric-strip" aria-label="Selected impact metrics">
					{content.metrics.map((metric) => (
						<div class="metric-item">
							<strong>{metric.value}</strong>
							<span>{metric.label}</span>
						</div>
					))}
				</div>
				<ul class="competency-list" aria-label="Core competencies">
					{content.competencies.map((competency) => <li>{competency}</li>)}
				</ul>
			</section>

			<section id="experiencia" aria-labelledby="experiencia-heading" class="reveal">
				<h2 id="experiencia-heading">
					<span class="section-num" aria-hidden="true">{t.sections.experiencia.num}</span>{
						t.sections.experiencia.title
					}
				</h2>
				<div class="timeline-list">
					{
						content.experience.map((role) => (
							<article class="timeline-item">
								<p class="meta">{role.period}</p>
								<div>
									<h3>{role.title}</h3>
									<p class="item-subtitle"><span>{role.company}</span> / {role.location}</p>
									<ul class="detail-list">
										{role.bullets.map((bullet) => <li>{bullet}</li>)}
									</ul>
									<ul class="tag-list" aria-label="Stack">
										{role.tags.map((tag) => <li>{tag}</li>)}
									</ul>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section id="certificaciones" aria-labelledby="certificaciones-heading" class="reveal">
				<h2 id="certificaciones-heading">
					<span class="section-num" aria-hidden="true">{t.sections.certificaciones.num}</span>{
						t.sections.certificaciones.title
					}
				</h2>
				<div class="record-list certifications-list">
					{
						content.certifications.map((certification) => {
							const hasVerificationLink = !certification.href.startsWith("[VERIFY_URL_");

							return (
								<article class="record certification-card">
									{hasVerificationLink ? (
										<a class="certification-link" href={certification.href}>
											<h3>{certification.title}</h3>
											<p>{certification.detail}</p>
											{certification.note && <small class="certification-note">{certification.note}</small>}
											<span>Verify credential</span>
										</a>
									) : (
										<div class="certification-link certification-link-static">
											<h3>{certification.title}</h3>
											<p>{certification.detail}</p>
											{certification.note && <small class="certification-note">{certification.note}</small>}
										</div>
									)}
								</article>
							);
						})
					}
				</div>
			</section>

			<section id="proyectos" aria-labelledby="proyectos-heading" class="reveal">
				<h2 id="proyectos-heading">
					<span class="section-num" aria-hidden="true">{t.sections.proyectos.num}</span>{
						t.sections.proyectos.title
					}
				</h2>
				<div class="project-list">
					{
						content.projects.map((project) => (
							<article class="project-card">
								<div class="project-heading">
									<div>
										<h3>{project.title}</h3>
										{project.subtitle && <p class="project-subtitle">{project.subtitle}</p>}
									</div>
									<div class="project-badges">
										<span class="type-badge">{project.type}</span>
									</div>
								</div>
								<p class="meta">{project.meta}</p>
								<p>{project.body}</p>
								<ul class="tag-list project-tags" aria-label="Project stack">
									{project.tags.map((tag) => <li>{tag}</li>)}
								</ul>
							</article>
						))
					}
				</div>
			</section>

			<section id="educacion" aria-labelledby="educacion-heading" class="reveal">
				<h2 id="educacion-heading">
					<span class="section-num" aria-hidden="true">{t.sections.educacion.num}</span>{
						t.sections.educacion.title
					}
				</h2>
				<article class="record education-record education-card">
					<h3>{content.education.title}</h3>
					<p>{content.education.detail}</p>
				</article>
			</section>

			<section id="contacto" aria-labelledby="contacto-heading" class="reveal">
				<h2 id="contacto-heading">
					<span class="section-num" aria-hidden="true">{t.sections.contacto.num}</span>{
						t.sections.contacto.title
					}
				</h2>
				<div class="copy contact-copy">
					<p>{content.contact.body} <span class="contact-lead">{content.contact.lead}</span></p>
				</div>
				<ul class="contact-list" aria-label="Contact links">
					{
						content.contact.links.map((link) => (
							<li>
								<a href={link.href} aria-label={link.label} title={link.label}>
									{link.icon === "email" && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M4 6h16v12H4z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
											<path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
										</svg>
									)}
									{link.icon === "linkedin" && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path fill="currentColor" d="M6.5 8.7H3.8V20h2.7V8.7Zm.2-3.5A1.55 1.55 0 1 0 3.6 5.2a1.55 1.55 0 0 0 3.1 0ZM20.4 13.5c0-3.2-1.7-4.9-4.1-4.9-1.9 0-2.7 1-3.2 1.8V8.7h-2.6V20h2.7v-6.3c0-1.7.8-2.7 2.2-2.7 1.3 0 2.2.9 2.2 2.8V20h2.8v-6.5Z" />
										</svg>
									)}
									{link.icon === "github" && (
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path fill="currentColor" d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.5 1.1 3 .8.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.1-4.7-5 0-1.1.4-2 1.1-2.8-.1-.3-.5-1.4.1-2.8 0 0 .9-.3 2.9 1.1a10.1 10.1 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.4.2 2.5.1 2.8.7.8 1.1 1.7 1.1 2.8 0 3.9-2.4 4.7-4.7 5 .4.3.8 1 .8 2v3c0 .3.2.6.8.5A9.5 9.5 0 0 0 12 2.5Z" />
										</svg>
									)}
									<span class="sr-only">{link.label}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

		</div>

		<footer>
			<p>&copy; {new Date().getFullYear()} {SITE.name}</p>
		</footer>
	</main>
</div>

<script>
	import "../scripts/scroll-spy";
</script>
