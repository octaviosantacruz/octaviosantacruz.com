				tags: ["Go", "Redis", "WebCrypto", "AES-GCM", "Docker"],
			},
			{
				title: "AccessGraph",
				type: "Private lab / closed source",
				subtitle: "CMDB de visibilidad de accesos privilegiados en CyberArk",
				meta: "CyberArk Access Visibility Tool / 2026 - Actualidad",
				body:
