---
import { Image } from "astro:assets";
import DecisionDemo from "./DecisionDemo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { SITE, PERSON } from "../consts";
import { translations, type Locale } from "../i18n/translations";
import { content as allContent } from "../data/content";
import switchboardPasskeys from "../assets/projects/switchboard-passkeys.png";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = translations[locale];
const content = allContent[locale];
const images = { "switchboard-passkeys": switchboardPasskeys };
const [featured, ...others] = content.projects;

// Header links; ids stay the same as before the redesign so old links work.
const nav = [
	{ href: "#proyectos", label: content.nav.projects },
	{ href: "#experiencia", label: content.nav.experience },
	{ href: "#sobre-mi", label: content.nav.profile },
	{ href: "#contacto", label: content.nav.contact },
];
---

<a class="skip-link" href="#contenido">{t.skipLink}</a>

<header class="site-header">
	<div class="wrap header-row">
		<a class="wordmark" href="#top">{PERSON.fullName}</a>
		<nav aria-label={t.navLabel}>
			<ul>
				{nav.map((item) => <li><a href={item.href} data-nav-link>{item.label}</a></li>)}
			</ul>
			<span class="nav-indicator" aria-hidden="true"></span>
		</nav>
		<LanguageSwitcher />
	</div>
</header>

<main class="content" id="contenido">
	<section class="hero" id="top" aria-labelledby="hero-heading">
		<div class="wrap hero-grid">
			<div class="hero-copy">
				<h1 id="hero-heading" class="identity">
					<span class="identity-name">{PERSON.fullName}</span>
					<span class="identity-role">{PERSON.jobTitle}</span>
				</h1>
				<p class="statement">{content.hero.statement}</p>
				<p class="support">{content.hero.support}</p>
				<div class="actions">
					<a class="button button-primary" href="#proyectos">{content.hero.ctaProjects}</a>
					<a class="button" href="#contacto">{content.hero.ctaContact}</a>
				</div>
			</div>
			<aside class="glance" aria-label={content.hero.nowLabel}>
				<p class="kicker">{content.hero.nowLabel}</p>
				<dl>
					{
						content.hero.now.map((fact) => (
							<div>
								<dt>{fact.label}</dt>
								<dd>{fact.value}</dd>
							</div>
						))
					}
				</dl>
			</aside>
		</div>
	</section>

	<section id="proyectos" class="band" aria-labelledby="proyectos-heading">
		<div class="wrap">
			<p class="kicker">{content.sections.projects.kicker}</p>
			<h2 id="proyectos-heading">{content.sections.projects.title}</h2>

			<article class="feature" data-reveal>
				<div class="feature-copy">
					<div class="badges">
						<span class="badge badge-stage">{featured.stage}</span>
						<span class="badge">{featured.type}</span>
					</div>
					<h3>{featured.title}</h3>
					<p class="feature-subtitle">{featured.subtitle}</p>
					{
						featured.featured && (
							<dl class="points">
								{featured.featured.points.map((point) => (
									<div>
										<dt>{point.label}</dt>
										<dd>{point.text}</dd>
									</div>
								))}
							</dl>
						)
					}
					{featured.featured?.demo && <DecisionDemo demo={featured.featured.demo} />}
					<ul class="tags" aria-label={t.ui.projectStackLabel}>
						{featured.tags.map((tag) => <li>{tag}</li>)}
					</ul>
					<p class="availability">{featured.availability}</p>
					{featured.href && <a class="text-link" href={featured.href}>{featured.linkLabel}<span aria-hidden="true"> →</span></a>}
				</div>
				{
					featured.featured && (
						<figure class="feature-shot">
							<Image
								src={images[featured.featured.image]}
								alt={featured.featured.imageAlt}
								widths={[320, 460, 640]}
								sizes="(min-width: 64rem) 22rem, 80vw"
								loading="lazy"
							/>
							<figcaption>{featured.featured.caption}</figcaption>
						</figure>
					)
				}
			</article>

			<div class="project-grid">
				{
					others.map((project) => (
						<article class="project" data-reveal>
							<div class="badges">
								<span class="badge badge-stage">{project.stage}</span>
								<span class="badge">{project.type}</span>
							</div>
							<h3>{project.title}</h3>
							<p class="project-subtitle">{project.subtitle}</p>
							<p>{project.body}</p>
							<ul class="tags" aria-label={t.ui.projectStackLabel}>
								{project.tags.map((tag) => <li>{tag}</li>)}
							</ul>
							<p class="availability">{project.availability}</p>
							{project.href && <a class="text-link" href={project.href}>{project.linkLabel}<span aria-hidden="true"> →</span></a>}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="experiencia" class="band" aria-labelledby="experiencia-heading">
		<div class="wrap">
			<p class="kicker">{content.sections.experience.kicker}</p>
			<h2 id="experiencia-heading">{content.sections.experience.title}</h2>
			<ul class="metrics" aria-label={t.ui.metricsLabel}>
				{
					content.metrics.map((metric) => (
						<li data-reveal>
							<strong>{metric.value}</strong>
							<span>{metric.label}</span>
						</li>
					))
				}
			</ul>
			<div class="timeline">
				{
					content.experience.map((role) => (
						<article class="role" data-reveal>
							<p class="period">{role.period}</p>
							<div>
								<h3>{role.title}</h3>
								<p class="role-org">{role.company} · {role.location}</p>
								<ul class="bullets">
									{role.bullets.map((bullet) => <li>{bullet}</li>)}
								</ul>
								<ul class="tags" aria-label={t.ui.roleStackLabel}>
									{role.tags.map((tag) => <li>{tag}</li>)}
								</ul>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="sobre-mi" class="band" aria-labelledby="sobre-mi-heading">
		<div class="wrap profile">
			<div>
				<p class="kicker">{content.sections.profile.kicker}</p>
				<h2 id="sobre-mi-heading">{content.sections.profile.title}</h2>
			</div>
			<div>
				<div class="prose">
					{content.about.map((paragraph) => <p>{paragraph}</p>)}
				</div>
				<ul class="tags tags-quiet" aria-label={t.ui.competenciesLabel}>
					{content.competencies.map((competency) => <li>{competency}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section id="certificaciones" class="band" aria-labelledby="certificaciones-heading">
		<div class="wrap">
			<p class="kicker">{content.sections.certifications.kicker}</p>
			<h2 id="certificaciones-heading">{content.sections.certifications.title}</h2>
			<ul class="credentials">
				{
					content.certifications.map((certification) => (
						<li data-reveal>
							<a href={certification.href}>
								<span class="credential-title">{certification.title}</span>
								<span class="credential-issuer">{certification.detail}</span>
								{certification.note && <span class="credential-note">{certification.note}</span>}
								<span class="credential-verify">{t.ui.verifyCredential}<span aria-hidden="true"> ↗</span></span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section id="educacion" class="band" aria-labelledby="educacion-heading">
		<div class="wrap profile">
			<div>
				<p class="kicker">{content.sections.education.kicker}</p>
				<h2 id="educacion-heading">{content.sections.education.title}</h2>
			</div>
			<div class="prose">
				<h3>{content.education.title}</h3>
				<p>{content.education.detail}</p>
			</div>
		</div>
	</section>

	<section id="contacto" class="band band-contact" aria-labelledby="contacto-heading">
		<div class="wrap">
			<p class="kicker">{content.sections.contact.kicker}</p>
			<h2 id="contacto-heading">{content.sections.contact.title}</h2>
			<p class="contact-body">{content.contact.body}</p>
			<ul class="contact-links" aria-label={t.ui.contactLinksLabel}>
				{
					content.contact.links.map((link) => (
						<li>
							<a href={link.href}>
								{link.icon === "email" && (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M4 6h16v12H4z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8" />
										<path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
									</svg>
								)}
								{link.icon === "linkedin" && (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path fill="currentColor" d="M6.5 8.7H3.8V20h2.7V8.7Zm.2-3.5A1.55 1.55 0 1 0 3.6 5.2a1.55 1.55 0 0 0 3.1 0ZM20.4 13.5c0-3.2-1.7-4.9-4.1-4.9-1.9 0-2.7 1-3.2 1.8V8.7h-2.6V20h2.7v-6.3c0-1.7.8-2.7 2.2-2.7 1.3 0 2.2.9 2.2 2.8V20h2.8v-6.5Z" />
									</svg>
								)}
								{link.icon === "github" && (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path fill="currentColor" d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.5 1.1 3 .8.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.1-4.7-5 0-1.1.4-2 1.1-2.8-.1-.3-.5-1.4.1-2.8 0 0 .9-.3 2.9 1.1a10.1 10.1 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.4.2 2.5.1 2.8.7.8 1.1 1.7 1.1 2.8 0 3.9-2.4 4.7-4.7 5 .4.3.8 1 .8 2v3c0 .3.2.6.8.5A9.5 9.5 0 0 0 12 2.5Z" />
									</svg>
								)}
								<span>{link.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</main>

<footer class="site-footer">
	<div class="wrap">
		<p>&copy; {new Date().getFullYear()} {SITE.name}</p>
	</div>
</footer>

<script>
	import "../scripts/scroll-spy";
	import "../scripts/reveal";
</script>
