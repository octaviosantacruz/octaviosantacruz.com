---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../i18n/translations";

const locale = (Astro.currentLocale ?? "en") as Locale;
---

<div class="lang-switch" role="group" aria-label="Language / Idioma">
	<a href={getRelativeLocaleUrl("es", "/")} aria-current={locale === "es" ? "page" : undefined}>ES</a>
	<span aria-hidden="true">·</span>
	<a href={getRelativeLocaleUrl("en", "/")} aria-current={locale === "en" ? "page" : undefined}>EN</a>
</div>
