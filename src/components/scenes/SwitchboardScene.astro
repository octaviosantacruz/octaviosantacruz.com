---
// The real Switchboard sign-in in front of an app: the gate asks for a
// passkey, then the policy decides. Copy follows internal/passkey/assets.
import type { Locale } from "../../i18n/translations";

interface Props { locale: Locale }
const es = Astro.props.locale === "es";
const t = (en: string, esText: string) => (es ? esText : en);
const finger = [
	"M6.6 17.6A8 8 0 0 1 4 11.5a8 8 0 0 1 16 0",
	"M9.2 20a10 10 0 0 1-1.7-6.5 4.5 4.5 0 0 1 9 0c0 1.5-.2 2.9-.6 4.2",
	"M12 13.5c0 2.8.5 5 1.6 7",
	"M19.6 15.4c-.2 1.3-.6 2.6-1.1 3.7",
];
---

<div class="sb">
	<div class="win">
		<div class="bar" aria-hidden="true">
			<i></i><i></i><i></i>
			<span class="url"><svg viewBox="0 0 16 16"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5" /><path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" /></svg>grafana.home.example</span>
		</div>
		<div class="view">
			<div class="app" aria-hidden="true">
				<div class="app-head"><b></b><i></i><i></i></div>
				<div class="tiles"><span><em>99.98%</em></span><span><em>412 ms</em></span><span><em>3 hosts</em></span></div>
				<svg class="chart" viewBox="0 0 300 80" preserveAspectRatio="none">
					<path class="area" d="M0 62 C 30 58, 45 30, 75 36 S 120 66, 150 48 S 210 14, 240 26 S 285 40, 300 22 V 80 H 0 Z" />
					<path class="line" d="M0 62 C 30 58, 45 30, 75 36 S 120 66, 150 48 S 210 14, 240 26 S 285 40, 300 22" />
				</svg>
			</div>

			<div class="pane card signin" data-only="0">
				<span class="brand"><svg viewBox="0 0 32 32" aria-hidden="true"><path class="cord" d="M9 22 C 9 8, 23 24, 23 10" /><circle class="jack" cx="9" cy="23" r="3.6" /><circle class="jack" cx="23" cy="9" r="3.6" /><circle class="led" cx="23" cy="9" r="1.3" /></svg>switchboard<b>_</b></span>
				<strong>{t("Sign in", "Iniciar sesión")}</strong>
				<p>{t("Use Face ID, Touch ID, Windows Hello or a security key.", "Usá Face ID, Touch ID, Windows Hello o una llave de seguridad.")}</p>
				<span class="btn">{t("Sign in with a passkey", "Entrar con passkey")}</span>
				<span class="cursor" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 2l10 6.2-4.4 1L6.4 14z" /></svg></span>
			</div>

			{[{ who: "Ana", ok: true }, { who: "Leo", ok: false }].map(({ who, ok }, i) => (
				<div class:list={["pane card verdict", ok ? "is-allow" : "is-deny"]} data-only={String(i + 1)}>
					<span class="ring" aria-hidden="true">
						<svg class="finger" viewBox="0 0 24 24">{finger.map(d => <path d={d} />)}</svg>
						<svg class="arc" viewBox="0 0 64 64"><circle cx="32" cy="32" r="29" pathLength="1" /></svg>
					</span>
					<strong>{who}</strong>
					<span class="passed">{t("passkey verified", "passkey verificada")}</span>
					<span class="decision">{ok ? "allow · group:admins" : t("deny · requires group:admins", "deny · requiere group:admins")}</span>
				</div>
			))}
			<span class="toast" data-only="1" aria-hidden="true">● Ana · allow</span>
			<span class="lock" data-only="2" aria-hidden="true">403</span>
		</div>
		<p class="log">
			<span data-only="0"><b>GET /</b> {t("no session → sign-in", "sin sesión → inicio de sesión")}</span>
			<span data-only="1"><b>ana</b> identify ✓ <i>→</i> authorize <em class="ok">allow</em> <i>→</i> {t("tunnel → home", "túnel → casa")}</span>
			<span data-only="2"><b>leo</b> identify ✓ <i>→</i> authorize <em class="no">deny</em> <i>·</i> {t("the app never sees it", "la app nunca la recibe")}</span>
		</p>
	</div>
</div>

<style>
	.sb { --amber: oklch(0.83 0.13 75); --ok: oklch(0.82 0.1 155); --no: oklch(0.74 0.14 25); display: grid; place-items: center; width: 100%; }
	.win { width: min(100%, 31rem); border: 1px solid var(--border); border-radius: 0.8rem; background: oklch(0.13 0.006 260); box-shadow: 0 30px 60px -30px oklch(0 0 0 / 0.7), 0 0 0 1px oklch(1 0 0 / 0.02) inset; overflow: hidden; }
	.bar { display: flex; align-items: center; gap: 0.35rem; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border); }
	.bar > i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: oklch(0.3 0.01 260); }
	.url { display: flex; align-items: center; gap: 0.35rem; margin-inline: auto; padding: 0.2rem 0.8rem; border-radius: 999px; background: oklch(0.19 0.007 260); font: 0.66rem var(--font-mono); color: var(--fg-muted); }
	.url svg { width: 0.75rem; fill: none; stroke: currentColor; stroke-width: 1.3; }
	.view { position: relative; display: grid; place-items: center; height: 17.5rem; overflow: hidden; }

	/* The protected app: always there, only readable once access is allowed. */
	.app { position: absolute; inset: 0; display: grid; grid-template-rows: auto auto 1fr; gap: 0.8rem; padding: 1.1rem; filter: blur(7px) saturate(0.4); opacity: 0.35; transition: filter 0.5s, opacity 0.5s; }
	.app-head { display: flex; gap: 0.5rem; align-items: center; }
	.app-head b { width: 5rem; height: 0.55rem; border-radius: 3px; background: var(--fg-muted); }
	.app-head i { width: 2.5rem; height: 0.45rem; border-radius: 3px; background: var(--border); }
	.tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
	.tiles span { padding: 0.7rem; border: 1px solid var(--border); border-radius: 0.45rem; background: var(--bg-raised); }
	.tiles em { font: 500 0.9rem var(--font-mono); font-style: normal; color: var(--fg); }
	.chart { width: 100%; height: 100%; }
	.chart .area { fill: color-mix(in oklch, var(--ok) 14%, transparent); }
	.chart .line { fill: none; stroke: var(--ok); stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-dasharray: 1200; }
	:global([data-frame="1"]) .app { animation: unblur 0.9s 2.3s var(--ease-out) both; }
	:global([data-frame="1"]) .chart .line { animation: trace 1.4s 2.6s var(--ease-out) both; }

	.pane { animation: card-in 0.55s var(--ease-out) both; }
	.card { position: relative; z-index: 1; display: grid; justify-items: center; gap: 0.55rem; width: min(84%, 17rem); padding: 1.4rem 1.2rem; border: 1px solid oklch(0.32 0.01 260); border-radius: 0.8rem; background: oklch(0.175 0.007 260 / 0.92); backdrop-filter: blur(6px); text-align: center; box-shadow: 0 20px 40px -20px oklch(0 0 0 / 0.8); }
	.card strong { font-size: 1.05rem; letter-spacing: -0.02em; }
	.card p { font-size: 0.72rem; line-height: 1.5; color: var(--fg-muted); }
	.brand { display: flex; align-items: center; gap: 0.4rem; font: 600 0.72rem var(--font-mono); color: var(--fg-soft); }
	.brand b { color: var(--amber); animation: blink 1s steps(1) infinite; }
	.brand svg { width: 1.3rem; fill: none; }
	.brand .cord { stroke: var(--fg-muted); stroke-width: 2.4; stroke-linecap: round; }
	.brand .jack { stroke: var(--fg-soft); stroke-width: 1.6; fill: oklch(0.13 0.006 260); }
	.brand .led { fill: var(--amber); }
	.btn { margin-top: 0.3rem; padding: 0.55rem 1rem; border-radius: 0.45rem; background: var(--fg); color: oklch(0.15 0.006 260); font-size: 0.74rem; font-weight: 700; animation: press 0.3s 2.35s both; }
	.cursor { position: absolute; left: 58%; top: 82%; width: 1.1rem; animation: cursor 2.2s 0.5s cubic-bezier(.6, 0, .25, 1) both; }
	.cursor svg { fill: var(--fg); stroke: oklch(0.15 0.006 260); stroke-width: 1; filter: drop-shadow(0 2px 3px oklch(0 0 0 / 0.5)); }

	/* Passkey ceremony, then the policy decision. */
	.verdict { --tone: var(--ok); }
	.is-deny { --tone: var(--no); }
	.ring { position: relative; display: grid; place-items: center; width: 4rem; height: 4rem; margin-bottom: 0.2rem; }
	.finger { width: 2rem; fill: none; stroke: var(--fg-muted); stroke-width: 1.4; stroke-linecap: round; animation: finger 1.4s both; }
	.arc { position: absolute; inset: 0; rotate: -90deg; }
	.arc circle { fill: none; stroke: var(--tone); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; animation: arc 1.1s 0.35s var(--ease-out) both; }
	.passed { font: 0.66rem var(--font-mono); color: var(--fg-muted); animation: fade 0.4s 1.3s both; }
	.decision { padding: 0.3rem 0.65rem; border: 1px solid color-mix(in oklch, var(--tone) 45%, transparent); border-radius: 999px; background: color-mix(in oklch, var(--tone) 12%, transparent); font: 600 0.68rem var(--font-mono); color: var(--tone); animation: pop 0.45s 1.65s var(--ease-out) both; }
	.is-allow { animation: card-in 0.55s var(--ease-out) both, card-out 0.5s 2.2s ease-in forwards; }
	.is-deny { animation: card-in 0.55s var(--ease-out) both, shake 0.45s 1.7s both; }
	.is-deny .finger { stroke: var(--fg-soft); }
	.toast { position: absolute; top: 0.8rem; right: 0.8rem; padding: 0.25rem 0.6rem; border-radius: 999px; background: color-mix(in oklch, var(--ok) 16%, oklch(0.13 0.006 260)); font: 600 0.62rem var(--font-mono); color: var(--ok); animation: fade 0.4s 2.6s both; }
	.lock { position: absolute; top: 0.8rem; right: 0.8rem; font: 600 0.62rem var(--font-mono); color: var(--no); animation: fade 0.4s 2s both; }

	.log { padding: 0.6rem 0.9rem; border-top: 1px solid var(--border); font: 0.68rem/1.5 var(--font-mono); color: var(--fg-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.log > span { display: inline-block; animation: type 1.2s 0.2s steps(40) both; }
	.log b { color: var(--fg); font-weight: 500; }
	.log i { font-style: normal; opacity: 0.6; }
	.log em { font-style: normal; } .log .ok { color: var(--ok); } .log .no { color: var(--no); }

	@keyframes card-in { from { opacity: 0; transform: translateY(10px) scale(0.97); } }
	@keyframes card-out { to { opacity: 0; transform: translateY(-8px) scale(0.96); visibility: hidden; } }
	@keyframes unblur { to { filter: none; opacity: 1; } }
	@keyframes trace { from { stroke-dashoffset: 1200; } to { stroke-dashoffset: 0; } }
	@keyframes cursor { from { left: 88%; top: 108%; opacity: 1; } 70% { left: 60%; top: 80%; opacity: 1; } 90% { left: 60%; top: 80%; opacity: 1; } to { left: 60%; top: 80%; opacity: 0; } }
	@keyframes press { 50% { transform: scale(0.95); box-shadow: 0 0 0 5px oklch(1 0 0 / 0.12); } }
	@keyframes finger { 0% { opacity: 0.3; } 40% { opacity: 1; } 100% { opacity: 1; } }
	@keyframes arc { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
	@keyframes pop { from { opacity: 0; transform: scale(0.85); } }
	@keyframes fade { from { opacity: 0; } }
	@keyframes shake { 20%, 60% { transform: translateX(-5px); } 40%, 80% { transform: translateX(5px); } }
	@keyframes blink { 50% { opacity: 0; } }
	@keyframes type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

	@media (prefers-reduced-motion: reduce) {
		.sb *, .sb *::before { animation: none !important; transition: none !important; }
		:global([data-frame="1"]) .app { filter: none; opacity: 1; }
		.is-allow, .cursor { display: none; }
	}
	@media (max-width: 42rem) { .view { height: 15.5rem; } .tiles em { font-size: 0.72rem; } }
</style>
