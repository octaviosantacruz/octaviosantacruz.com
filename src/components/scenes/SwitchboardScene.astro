---
// Switchboard today and where it is going (VISION.md): passkey and policy
// first, then context signals, just-in-time access with phone approval and
// decisions explained in plain language. Steps after the first are roadmap.
import type { Locale } from "../../i18n/translations";

interface Props { locale: Locale }
const es = Astro.props.locale === "es";
const t = (en: string, esText: string) => (es ? esText : en);
const finger = [
	"M6.6 17.6A8 8 0 0 1 4 11.5a8 8 0 0 1 16 0",
	"M9.2 20a10 10 0 0 1-1.7-6.5 4.5 4.5 0 0 1 9 0c0 1.5-.2 2.9-.6 4.2",
	"M12 13.5c0 2.8.5 5 1.6 7",
	"M19.6 15.4c-.2 1.3-.6 2.6-1.1 3.7",
];
---

<div class="sb">
	<div class="win">
		<div class="bar" aria-hidden="true">
			<i></i><i></i><i></i>
			<span class="url">
				<svg viewBox="0 0 16 16"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5" /><path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7" /></svg>
				<span data-only="0">grafana.example</span><span data-only="1">grafana.example</span><span data-only="2">ssh db-prod</span><span data-only="3">switchboard · {t("decisions", "decisiones")}</span>
			</span>
			<span class="next" data-not="0">{t("Next", "Próximo")}</span>
		</div>
		<div class="view">
			<div class="app" aria-hidden="true">
				<div class="app-head"><b></b><i></i><i></i></div>
				<div class="tiles"><span><em>99.98%</em></span><span><em>412 ms</em></span><span><em>3 hosts</em></span></div>
				<svg class="chart" viewBox="0 0 300 80" preserveAspectRatio="none">
					<path class="area" d="M0 62 C 30 58, 45 30, 75 36 S 120 66, 150 48 S 210 14, 240 26 S 285 40, 300 22 V 80 H 0 Z" />
					<path class="line" d="M0 62 C 30 58, 45 30, 75 36 S 120 66, 150 48 S 210 14, 240 26 S 285 40, 300 22" />
				</svg>
			</div>

			<!-- 1 · Identity: sign in, passkey, policy allows, the app opens. -->
			<div class="card signin" data-only="0">
				<span class="brand"><svg viewBox="0 0 32 32" aria-hidden="true"><path class="cord" d="M9 22 C 9 8, 23 24, 23 10" /><circle class="jack" cx="9" cy="23" r="3.6" /><circle class="jack" cx="23" cy="9" r="3.6" /><circle class="led" cx="23" cy="9" r="1.3" /></svg>switchboard<b>_</b></span>
				<strong>{t("Sign in", "Iniciar sesión")}</strong>
				<p>{t("This app is protected. Authenticate with your passkey to continue.", "Esta app está protegida. Autenticate con tu passkey para continuar.")}</p>
				<span class="btn">{t("Sign in with a passkey", "Entrar con passkey")}</span>
				<span class="cursor" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 2l10 6.2-4.4 1L6.4 14z" /></svg></span>
			</div>
			<div class="card ceremony" data-only="0">
				<span class="ring" aria-hidden="true">
					<svg class="finger" viewBox="0 0 24 24">{finger.map(d => <path d={d} />)}</svg>
					<svg class="arc" viewBox="0 0 64 64"><circle cx="32" cy="32" r="29" pathLength="1" /></svg>
				</span>
				<strong>Ana</strong>
				<span class="decision ok">allow · group:admins</span>
			</div>
			<span class="toast" data-only="0" aria-hidden="true">● Ana · allow</span>

			<!-- 2 · Context: impossible travel triggers a step-up. -->
			<div class="card travel" data-only="1">
				<svg class="globe" viewBox="0 0 240 90" aria-hidden="true">
					<path class="route" d="M 52 66 Q 120 -6 192 34" />
					<circle class="city" cx="52" cy="66" r="4" /><circle class="city far" cx="192" cy="34" r="4" />
				</svg>
				<div class="cities"><span>Asunción <em>09:02</em></span><i>8,600 km · 12 min</i><span>Madrid <em>09:14</em></span></div>
				<span class="decision warn">{t("impossible travel", "viaje imposible")}</span>
				<span class="action">{t("step-up: fresh passkey + confirm on phone", "step-up: passkey nueva + confirmar en el teléfono")}</span>
			</div>

			<!-- 3 · Just in time: access requested, approved, expires on its own. -->
			<div class="card term" data-only="2">
				<code class="line1">$ sb ssh db-prod</code>
				<code class="line2">{t("leo has no standing access · request sent", "leo no tiene acceso permanente · pedido enviado")}</code>
				<code class="line3 ok">{t("approved for 1 h by octavio · session recorded", "aprobado por 1 h por octavio · sesión grabada")}</code>
				<span class="timer"><svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15" pathLength="1" /></svg><b>59:59</b>{t("expires on its own", "vence solo")}</span>
			</div>

			<!-- 4 · Explained: plain language from the trace, anchored in the log. -->
			<div class="card why" data-only="3">
				<span class="q">{t("Why was Ana asked to sign in again?", "¿Por qué se le pidió a Ana entrar de nuevo?")}</span>
				<p>{t("She appeared in Madrid 12 minutes after Asunción. Policy admins-strict requires a fresh passkey on impossible travel; she confirmed on her phone.", "Apareció en Madrid 12 minutos después de Asunción. La política admins-strict exige una passkey nueva ante un viaje imposible; ella confirmó en su teléfono.")}</p>
				<span class="log-entry"><b>#48213</b> {t("in the transparency log", "en el log de transparencia")} · <em>{t("inclusion verified", "inclusión verificada")} ✓</em></span>
			</div>
		</div>
		<p class="log">
			<span data-only="0"><b>ana</b> identify ✓ <i>→</i> authorize <em class="ok">allow</em> <i>→</i> {t("tunnel → home", "túnel → casa")}</span>
			<span data-only="1"><b>ana</b> {t("signal", "señal")} impossible_travel <i>→</i> <em class="warn">step-up</em> <i>→</i> {t("confirmed", "confirmado")}</span>
			<span data-only="2"><b>leo</b> jit db-prod 1h <i>→</i> <em class="ok">{t("approved", "aprobado")}</em> <i>→</i> {t("expires 10:14", "vence 10:14")}</span>
			<span data-only="3"><b>audit</b> verify <i>→</i> <em class="ok">{t("nothing rewritten", "nada reescrito")}</em></span>
		</p>
	</div>

	<div class="phone" data-only="1" aria-hidden="true">
		<span class="app-icon">SB</span>
		<strong>Switchboard</strong>
		<p>{t("Is this you signing in from Madrid?", "¿Sos vos entrando desde Madrid?")}</p>
		<span class="actions"><b class="yes">{t("Yes, it’s me", "Sí, soy yo")}</b><b>No</b></span>
	</div>
	<div class="phone" data-only="2" aria-hidden="true">
		<span class="app-icon">SB</span>
		<strong>Switchboard</strong>
		<p>{t("Leo wants ssh db-prod for 1 hour.", "Leo pide ssh db-prod por 1 hora.")}</p>
		<span class="actions"><b class="yes">✓ {t("Approve 1 h", "Aprobar 1 h")}</b><b>✕ {t("Deny", "Rechazar")}</b></span>
	</div>
</div>

<style>
	.sb { --amber: oklch(0.83 0.13 75); --ok: oklch(0.82 0.1 155); --no: oklch(0.74 0.14 25); position: relative; display: grid; place-items: center; width: 100%; }
	.win { width: min(100%, 31rem); border: 1px solid var(--border); border-radius: 0.8rem; background: oklch(0.13 0.006 260); box-shadow: 0 30px 60px -30px oklch(0 0 0 / 0.7); overflow: hidden; }
	.bar { display: flex; align-items: center; gap: 0.35rem; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--border); }
	.bar > i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: oklch(0.3 0.01 260); }
	.url { display: flex; align-items: center; gap: 0.35rem; margin-inline: auto; padding: 0.2rem 0.8rem; border-radius: 999px; background: oklch(0.19 0.007 260); font: 0.66rem var(--font-mono); color: var(--fg-muted); }
	.url svg { width: 0.75rem; fill: none; stroke: currentColor; stroke-width: 1.3; }
	.bar { position: relative; }
	.next { position: absolute; right: 0.8rem; padding: 0.1rem 0.5rem; border: 1px dashed var(--amber); border-radius: 999px; font: 0.6rem var(--font-mono); color: var(--amber); }
	.view { position: relative; display: grid; place-items: center; height: 18rem; overflow: hidden; }
	.view > .card { grid-area: 1 / 1; }

	/* The protected app: there all along, readable only once allowed. */
	.app { position: absolute; inset: 0; display: grid; grid-template-rows: auto auto 1fr; gap: 0.8rem; padding: 1.1rem; filter: blur(7px) saturate(0.4); opacity: 0.3; }
	.app-head { display: flex; gap: 0.5rem; align-items: center; }
	.app-head b { width: 5rem; height: 0.55rem; border-radius: 3px; background: var(--fg-muted); }
	.app-head i { width: 2.5rem; height: 0.45rem; border-radius: 3px; background: var(--border); }
	.tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
	.tiles span { padding: 0.7rem; border: 1px solid var(--border); border-radius: 0.45rem; background: var(--bg-raised); }
	.tiles em { font: 500 0.9rem var(--font-mono); font-style: normal; color: var(--fg); }
	.chart { width: 100%; height: 100%; }
	.chart .area { fill: color-mix(in oklch, var(--ok) 14%, transparent); }
	.chart .line { fill: none; stroke: var(--ok); stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-dasharray: 1200; }
	:global([data-frame="2"]) .app, :global([data-frame="3"]) .app { opacity: 0.12; }

	.card { position: relative; z-index: 1; display: grid; justify-items: center; gap: 0.55rem; width: min(86%, 18rem); padding: 1.3rem 1.2rem; border: 1px solid oklch(0.32 0.01 260); border-radius: 0.8rem; background: oklch(0.175 0.007 260 / 0.94); backdrop-filter: blur(6px); text-align: center; box-shadow: 0 20px 40px -20px oklch(0 0 0 / 0.8); animation: card-in 0.55s var(--ease-out) both; }
	.card strong { font-size: 1.05rem; letter-spacing: -0.02em; }
	.card p { font-size: 0.74rem; line-height: 1.5; color: var(--fg-muted); }
	.decision { padding: 0.3rem 0.65rem; border: 1px solid color-mix(in oklch, var(--tone) 45%, transparent); border-radius: 999px; background: color-mix(in oklch, var(--tone) 12%, transparent); font: 600 0.66rem var(--font-mono); color: var(--tone); }
	.ok { --tone: var(--ok); } .warn { --tone: var(--amber); }

	/* 1 · sign-in, then the ceremony takes its place */
	.brand { display: flex; align-items: center; gap: 0.4rem; font: 600 0.72rem var(--font-mono); color: var(--fg-soft); }
	.brand b { color: var(--amber); animation: blink 1s steps(1) infinite; }
	.brand svg { width: 1.3rem; fill: none; }
	.brand .cord { stroke: var(--fg-muted); stroke-width: 2.4; stroke-linecap: round; }
	.brand .jack { stroke: var(--fg-soft); stroke-width: 1.6; fill: oklch(0.13 0.006 260); }
	.brand .led { fill: var(--amber); }
	.btn { margin-top: 0.3rem; padding: 0.55rem 1rem; border-radius: 0.45rem; background: var(--fg); color: oklch(0.15 0.006 260); font-size: 0.74rem; font-weight: 700; animation: press 0.3s 2.1s both; }
	.cursor { position: absolute; left: 60%; top: 80%; width: 1.1rem; opacity: 0; animation: cursor 2.2s 0.4s cubic-bezier(.6, 0, .25, 1) both; }
	.cursor svg { fill: var(--fg); stroke: oklch(0.15 0.006 260); stroke-width: 1; filter: drop-shadow(0 2px 3px oklch(0 0 0 / 0.5)); }
	.signin { animation: card-in 0.55s var(--ease-out) both, card-out 0.35s 2.45s ease-in forwards; }
	.ceremony { animation: card-in 0.45s 2.7s var(--ease-out) both, card-out 0.45s 5s ease-in forwards; }
	.ring { position: relative; display: grid; place-items: center; width: 4rem; height: 4rem; }
	.finger { width: 2rem; fill: none; stroke: var(--fg-soft); stroke-width: 1.4; stroke-linecap: round; }
	.arc { position: absolute; inset: 0; rotate: -90deg; }
	.arc circle { fill: none; stroke: var(--ok); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; animation: dash 1s 3s var(--ease-out) both; }
	.ceremony .decision { animation: pop 0.4s 4s var(--ease-out) both; }
	:global([data-frame="0"]) .app { animation: unblur 0.9s 5.2s var(--ease-out) both; }
	:global([data-frame="0"]) .chart .line { animation: trace 1.3s 5.4s var(--ease-out) both; }
	.toast { position: absolute; top: 0.8rem; right: 0.8rem; padding: 0.25rem 0.6rem; border-radius: 999px; background: color-mix(in oklch, var(--ok) 16%, oklch(0.13 0.006 260)); font: 600 0.62rem var(--font-mono); color: var(--ok); animation: fade 0.4s 5.6s both; }

	/* 2 · impossible travel */
	.globe { width: 100%; height: 4.6rem; overflow: visible; }
	.route { fill: none; stroke: var(--amber); stroke-width: 1.4; stroke-dasharray: 4 4; stroke-dashoffset: 200; animation: route 1.4s 0.4s linear both; }
	.city { fill: var(--fg-soft); }
	.far { fill: var(--amber); animation: pulse-dot 1.2s 1.8s ease-out 2 both; }
	.cities { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.5rem; width: 100%; font: 0.68rem var(--font-mono); color: var(--fg-soft); }
	.cities em { font-style: normal; color: var(--fg-muted); }
	.cities i { font: 0.6rem var(--font-mono); font-style: normal; color: var(--amber); text-align: center; }
	.cities span { display: grid; }
	.travel .decision { animation: pop 0.4s 2s var(--ease-out) both; }
	.action { font: 0.64rem var(--font-mono); color: var(--fg-muted); animation: fade 0.4s 2.6s both; }

	/* 3 · just in time */
	.term { justify-items: start; text-align: left; font-family: var(--font-mono); }
	.term code { font: 0.7rem/1.5 var(--font-mono); color: var(--fg-soft); }
	.line1 { animation: type 0.8s 0.3s steps(16) both; }
	.line2 { color: var(--fg-muted) !important; animation: fade 0.4s 1.3s both; }
	.line3 { color: var(--ok) !important; animation: fade 0.4s 3.6s both; }
	.timer { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.3rem; font: 0.64rem var(--font-mono); color: var(--fg-muted); animation: fade 0.4s 4s both; }
	.timer svg { width: 1.6rem; rotate: -90deg; }
	.timer circle { fill: none; stroke: var(--amber); stroke-width: 2.5; stroke-dasharray: 1; animation: drain 4s 4.2s linear both; }
	.timer b { color: var(--fg); font-weight: 500; }

	/* 4 · explained */
	.why { justify-items: start; text-align: left; width: min(90%, 21rem); }
	.q { font: 0.7rem var(--font-mono); color: var(--amber); }
	.why p { color: var(--fg-soft); font-size: 0.8rem; animation: type-lines 1.6s 0.5s steps(30) both; }
	.log-entry { padding-top: 0.6rem; border-top: 1px solid var(--border); width: 100%; font: 0.64rem var(--font-mono); color: var(--fg-muted); animation: fade 0.4s 2.4s both; }
	.log-entry b { color: var(--fg); font-weight: 500; }
	.log-entry em { font-style: normal; color: var(--ok); }

	/* The phone: approvals arrive where the person is. */
	/* With a phone in view, the card steps aside so nothing is covered. */
	.travel, .term { width: min(64%, 17rem); justify-self: start; margin-left: 1.1rem; }
	.phone { position: absolute; z-index: 2; right: max(0px, calc(50% - 18rem)); bottom: 3.4rem; display: grid; grid-template-columns: auto 1fr; gap: 0.15rem 0.55rem; width: 13rem; padding: 0.75rem; border: 1px solid oklch(0.36 0.012 260); border-radius: 1rem; background: oklch(0.21 0.008 260 / 0.96); backdrop-filter: blur(10px); box-shadow: 0 24px 48px -16px oklch(0 0 0 / 0.85); animation: phone-in 0.6s 1.9s cubic-bezier(.2, .9, .3, 1.15) both; }
	.phone:last-child { animation-delay: 1.6s; }
	.app-icon { grid-row: span 2; display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 0.45rem; background: var(--amber); color: oklch(0.2 0.03 75); font: 700 0.58rem var(--font-mono); }
	.phone strong { font-size: 0.7rem; }
	.phone p { font-size: 0.7rem; line-height: 1.4; color: var(--fg-soft); }
	.actions { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem; margin-top: 0.45rem; }
	.actions b { padding: 0.35rem; border-radius: 0.45rem; background: oklch(0.27 0.01 260); font-size: 0.64rem; font-weight: 600; text-align: center; color: var(--fg-soft); }
	.actions .yes { animation: tap 0.4s 3.1s both; }

	.log { padding: 0.6rem 0.9rem; border-top: 1px solid var(--border); font: 0.68rem/1.5 var(--font-mono); color: var(--fg-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.log > span { display: inline-block; animation: type 1.2s 0.2s steps(40) both; }
	.log b { color: var(--fg); font-weight: 500; }
	.log i { font-style: normal; opacity: 0.6; }
	.log em { font-style: normal; color: var(--tone); }

	@keyframes card-in { from { opacity: 0; transform: translateY(10px) scale(0.97); } }
	@keyframes card-out { to { opacity: 0; transform: translateY(-8px) scale(0.96); visibility: hidden; } }
	@keyframes unblur { to { filter: none; opacity: 1; } }
	@keyframes trace { from { stroke-dashoffset: 1200; } to { stroke-dashoffset: 0; } }
	@keyframes cursor { from { left: 88%; top: 108%; opacity: 1; } 70% { left: 60%; top: 80%; opacity: 1; } 90% { opacity: 1; } to { left: 60%; top: 80%; opacity: 0; } }
	@keyframes press { 50% { transform: scale(0.95); box-shadow: 0 0 0 5px oklch(1 0 0 / 0.12); } }
	@keyframes dash { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
	@keyframes drain { from { stroke-dashoffset: 0; } to { stroke-dashoffset: 0.25; } }
	@keyframes pop { from { opacity: 0; transform: scale(0.85); } }
	@keyframes fade { from { opacity: 0; } }
	@keyframes blink { 50% { opacity: 0; } }
	@keyframes route { to { stroke-dashoffset: 0; } }
	@keyframes pulse-dot { 50% { r: 7; } }
	@keyframes phone-in { from { opacity: 0; transform: translateY(24px) scale(0.94); } }
	@keyframes tap { 40% { transform: scale(0.94); } 100% { background: var(--ok); color: oklch(0.2 0.03 155); } }
	@keyframes type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
	@keyframes type-lines { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }

	@media (prefers-reduced-motion: reduce) {
		.sb *, .sb *::before { animation: none !important; transition: none !important; }
		:global([data-frame="0"]) .app { filter: none; opacity: 1; }
		.signin, .ceremony, .cursor { display: none; }
		.actions .yes { background: var(--ok); color: oklch(0.2 0.03 155); }
	}
	@media (max-width: 42rem) {
		.view { height: 16rem; }
		.tiles em { font-size: 0.72rem; }
		.travel, .term { width: min(86%, 18rem); justify-self: center; margin-left: 0; }
		.phone { position: relative; right: auto; bottom: auto; margin-top: 0.7rem; justify-self: end; }
		.bar > i { display: none; }
		.url { margin-inline: 0 auto; }
	}
</style>
