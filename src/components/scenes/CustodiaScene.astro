---
// A suspension bridge between two kinds of tool. Records travel from each
// tower, meet in the middle and only then a finding appears. Colours follow
// Custodia's own system: provenance by source type, verdict by shape.
import type { Locale } from "../../i18n/translations";

export interface Plane {
	step: string;
	q: string;
	a: { seal: string; name: string; src: string; record: string };
	b: { seal: string; name: string; src: string; record: string };
	verdict: "gap" | "partial";
	finding: string;
	out: string[];
}

interface Props { locale: Locale; planes: Plane[] }
const { planes } = Astro.props;
---

<div class="cu">
	{planes.map((plane, i) => (
		<div class="plane" data-only={String(i)} style={`--a: var(--src-${plane.a.src}); --b: var(--src-${plane.b.src})`}>
			<p class:list={["finding", `v-${plane.verdict}`]}><span class="shape" aria-hidden="true"></span>{plane.finding}</p>
			<div class="span">
				<div class="tower ta"><span class="seal">{plane.a.seal}</span><strong>{plane.a.name}</strong></div>
				<div class="deck" aria-hidden="true">
					<svg class="cable" viewBox="0 0 200 60" preserveAspectRatio="none">
						<path class="main" d="M 0 58 Q 100 -46 200 58" />
						{[20, 40, 60, 80, 100, 120, 140, 160, 180].map((x, k) => <line x1={x} x2={x} y1={58 - 208 * (x / 200) * (1 - x / 200)} y2="60" style={`--k: ${k}`} />)}
					</svg>
					<span class="road"></span>
					<span class="rec ra">{plane.a.record}</span>
					<span class="rec rb">{plane.b.record}</span>
					<span class="spark"></span>
				</div>
				<div class="tower tb"><span class="seal">{plane.b.seal}</span><strong>{plane.b.name}</strong></div>
			</div>
			<ul class="out">{plane.out.map((o, k) => <li style={`--k: ${k}`}>{o}</li>)}</ul>
		</div>
	))}
</div>

<style>
	.cu {
		--src-pam: oklch(0.75 0.14 296); --src-sse: oklch(0.77 0.14 352); --src-dspm: oklch(0.77 0.12 232);
		--src-edr: oklch(0.74 0.12 260); --src-vuln: oklch(0.76 0.1 205); --src-fw: oklch(0.74 0.07 275);
		--src-all: oklch(0.91 0.19 124);
		--v-gap: oklch(0.72 0.18 27); --v-partial: oklch(0.84 0.14 80);
		display: grid; place-items: center; width: 100%;
	}
	.plane { display: grid; justify-items: center; gap: 1.6rem; width: min(100%, 36rem); }

	/* The finding appears last: Custodia concludes only after the join. */
	.finding { display: flex; align-items: center; gap: 0.7rem; min-height: 3.2rem; max-width: 30rem; padding: 0.7rem 1rem; border: 1px solid var(--border); border-radius: 0.6rem; background: var(--bg-raised); font-size: 0.86rem; line-height: 1.45; text-align: left; animation: rise 0.6s 2.3s var(--ease-out) both; }
	.shape { flex-shrink: 0; width: 0.8rem; height: 0.8rem; background: var(--tone); }
	.v-gap { --tone: var(--v-gap); } .v-gap .shape { rotate: 45deg; }
	.v-partial { --tone: var(--v-partial); } .v-partial .shape { border-radius: 50%; background: linear-gradient(90deg, var(--tone) 50%, transparent 50%); box-shadow: inset 0 0 0 1.5px var(--tone); }

	.span { display: grid; grid-template-columns: 6.2rem minmax(0, 1fr) 6.2rem; align-items: end; width: 100%; }
	.tower { position: relative; display: grid; justify-items: center; gap: 0.35rem; padding: 0.9rem 0.4rem 0.75rem; border: 1px solid color-mix(in oklch, var(--tone) 40%, var(--border)); border-radius: 0.35rem; background: color-mix(in oklch, var(--tone) 7%, var(--bg-raised)); text-align: center; animation: rise 0.5s var(--ease-out) both; }
	.ta { --tone: var(--a); } .tb { --tone: var(--b); animation-delay: 0.1s; }
	.tower strong { font: 600 0.74rem/1.3 var(--font-mono); }
	.seal { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 0.3rem; background: var(--tone); color: oklch(0.2 0.02 260); font: 700 0.62rem var(--font-mono); }

	.deck { position: relative; height: 6.5rem; container-type: inline-size; }
	.cable { position: absolute; left: 0; right: 0; top: 0; bottom: 0.6rem; width: 100%; height: calc(100% - 0.6rem); overflow: visible; }
	.cable .main { fill: none; stroke: color-mix(in oklch, var(--fg-muted) 80%, transparent); stroke-width: 1.4; vector-effect: non-scaling-stroke; stroke-dasharray: 1200; animation: draw 0.9s 0.25s var(--ease-out) both; }
	.cable line { stroke: var(--border); stroke-width: 1; vector-effect: non-scaling-stroke; animation: fade 0.3s calc(0.6s + var(--k) * 0.04s) both; }
	.road { position: absolute; left: 0; right: 0; bottom: 0.55rem; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--a), var(--b)); opacity: 0.55; transform-origin: center; animation: road 0.7s 0.15s var(--ease-out) both; }
	.rec { position: absolute; bottom: 1.1rem; max-width: 46%; padding: 0.22rem 0.5rem; border: 1px solid color-mix(in oklch, var(--tone) 50%, transparent); border-radius: 0.3rem; background: oklch(0.15 0.006 260); font: 0.6rem/1.35 var(--font-mono); color: var(--tone); overflow-wrap: anywhere; }
	.ra { --tone: var(--a); left: 0; animation: from-left 1.2s 0.9s var(--ease-out) both; }
	.rb { --tone: var(--b); right: 0; animation: from-right 1.2s 0.9s var(--ease-out) both; }
	.spark { position: absolute; left: 50%; bottom: 0.55rem; width: 0.5rem; height: 0.5rem; translate: -50% 50%; border-radius: 50%; background: var(--fg); box-shadow: 0 0 14px 4px oklch(1 0 0 / 0.35); animation: spark 0.9s 1.95s both; }

	.out { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
	.out li { padding: 0.25rem 0.7rem; border: 1px solid var(--border); border-radius: 999px; font: 0.68rem var(--font-mono); color: var(--fg-soft); animation: rise 0.4s calc(2.7s + var(--k) * 0.12s) var(--ease-out) both; }

	@keyframes rise { from { opacity: 0; transform: translateY(8px); } }
	@keyframes fade { from { opacity: 0; } }
	@keyframes draw { from { stroke-dashoffset: 1200; } to { stroke-dashoffset: 0; } }
	@keyframes road { from { transform: scaleX(0); } }
	@keyframes from-left { from { opacity: 0; transform: translateX(-0.5rem); } 20% { opacity: 1; } to { transform: translateX(calc(50cqw - 100% - 0.35rem)); } }
	@keyframes from-right { from { opacity: 0; transform: translateX(0.5rem); } 20% { opacity: 1; } to { transform: translateX(calc(-50cqw + 100% + 0.35rem)); } }
	@keyframes spark { from { opacity: 0; transform: scale(0.2); } 30% { opacity: 1; transform: scale(1.4); } to { opacity: 0; transform: scale(3); } }

	@media (prefers-reduced-motion: reduce) {
		.cu *, .cu *::before { animation: none !important; }
		.ra { transform: translateX(calc(50cqw - 100% - 0.35rem)); }
		.rb { transform: translateX(calc(-50cqw + 100% + 0.35rem)); }
		.spark { display: none; }
	}
	@media (max-width: 42rem) {
		.span { grid-template-columns: 3.9rem minmax(0, 1fr) 3.9rem; }
		.tower { padding-inline: 0.2rem; }
		.tower strong { font-size: 0.58rem; overflow-wrap: anywhere; }
		.deck { height: 7.5rem; }
		.rec { max-width: 48%; padding: 0.2rem 0.35rem; font-size: 0.54rem; }
		.finding { font-size: 0.8rem; }
	}
</style>
