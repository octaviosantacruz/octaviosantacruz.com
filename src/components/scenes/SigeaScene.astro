---
// Port → CPE → probe, as the open check engine does it: a detector reads the
// banner, NVD maps the product to candidates, probes decide. Then the horizon:
// attack paths built only from verified findings.
// Example taken from agent/checks/examples/apache-httpd.
import type { Locale } from "../../i18n/translations";

interface Props { locale: Locale }
const es = Astro.props.locale === "es";
const t = (en: string, esText: string) => (es ? esText : en);
const candidates = [
	{ id: "CVE-2021-41773", state: "confirmed", label: t("Confirmed", "Confirmada") },
	{ id: "CVE-2021-42013", state: "inconclusive", label: t("Inconclusive", "Inconclusa"), note: t("needs a known configuration", "requiere una configuración conocida") },
	{ id: "CVE-2021-41524", state: "clear", label: t("Not affected", "No afectada"), note: t("HTTP/2 not enabled", "HTTP/2 no habilitado") },
];
const blips = [[30, 34], [68, 26], [74, 66], [38, 72], [55, 48]];
const path = [
	{ host: "Internet", detail: "" },
	{ host: "web-02", detail: "CVE-2021-41773 · " + t("confirmed", "confirmada") },
	{ host: "db-07", detail: t("reachable from web-02", "alcanzable desde web-02") },
	{ host: t("payroll", "nómina"), detail: t("sensitive data", "dato sensible") },
];
---

<div class="sg">
	<div class="radar" aria-hidden="true">
		<span class="rings"></span>
		<span class="sweep"></span>
		{blips.map(([x, y]) => <i class="blip" style={`left: ${x}%; top: ${y}%`}></i>)}
		<i class="blip target" style="left: 70%; top: 30%"></i>
		<span class="core"></span>
	</div>

	<div class="body">
		<div class="pane" data-only="0">
			<code class="target-line">192.0.2.14<b>:443</b><em>open</em></code>
			<code class="banner">Server: Apache/2.4.49 (Unix)</code>
			<span class="meta">sigea.apache-httpd.detect → <b>Apache HTTP Server 2.4.49</b></span>
		</div>

		<div class="pane" data-only="1">
			<span class="meta">NVD API</span>
			<code class="cpe"><span>cpe:2.3:a:</span>apache:http_server:2.4.49</code>
			<ul class="cands">{candidates.map((c, i) => <li style={`--k: ${i}`}><code>{c.id}</code><span>{t("candidate", "candidata")}</span></li>)}</ul>
		</div>

		<div class="pane" data-only="2">
			<ul class="cands checked">{candidates.map((c, i) => (
				<li class={`s-${c.state}`} style={`--k: ${i}`}>
					<span class="icon" aria-hidden="true"></span>
					<code>{c.id}</code>
					<span class="state">{c.label}</span>
					{c.note && <small>{c.note}</small>}
					{c.state === "confirmed" && <small class="evidence">probe sigea.apache-httpd.cve-2021-41773 · {t("evidence saved", "evidencia guardada")}</small>}
					<i class="scan"></i>
				</li>
			))}</ul>
			<span class="meta result">{t("Reported: 1 vulnerability. 2 stay out of the report.", "Se reporta: 1 vulnerabilidad. 2 quedan fuera del reporte.")}</span>
		</div>

		<div class="pane" data-only="3">
			<span class="next">{t("Next", "Próximo")}</span>
			<ol class="path">{path.map((n, i) => (
				<li style={`--k: ${i}`} class:list={{ crown: i === path.length - 1 }}><strong>{n.host}</strong>{n.detail && <small>{n.detail}</small>}</li>
			))}</ol>
			<span class="meta">{t("Built only from confirmed findings and verified reachability.", "Armado solo con hallazgos confirmados y alcanzabilidad verificada.")}</span>
		</div>
	</div>
</div>

<style>
	.sg {
		--violet: oklch(0.7 0.16 290); --signal: oklch(0.78 0.14 55);
		display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); align-items: center; gap: 1.8rem; width: 100%;
	}
	:global([data-frame="3"]) .sg { grid-template-columns: 1fr; }
	:global([data-frame="3"]) .radar { display: none; }

	/* Radar: quiet ink, one violet sweep. */
	.radar { position: relative; aspect-ratio: 1; border-radius: 50%; }
	.rings { position: absolute; inset: 0; border-radius: 50%; border: 1px solid oklch(0.34 0.012 260); background: repeating-radial-gradient(circle, transparent 0 calc(33.3% - 1px), oklch(0.3 0.01 260 / 0.7) calc(33.3% - 1px) 33.3%); -webkit-mask: radial-gradient(circle, #000 70.5%, transparent 71%); mask: radial-gradient(circle, #000 70.5%, transparent 71%); }
	.sweep { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, transparent 0 78%, oklch(0.7 0.16 290 / 0.04) 88%, oklch(0.7 0.16 290 / 0.26) 100%); animation: spin 5s linear infinite; animation-play-state: paused; }
	:global(.is-playing) .sweep { animation-play-state: running; }
	.core { position: absolute; left: 50%; top: 50%; width: 0.5rem; height: 0.5rem; translate: -50% -50%; border-radius: 50%; background: var(--fg-soft); }
	.blip { position: absolute; width: 0.32rem; height: 0.32rem; translate: -50% -50%; border-radius: 50%; background: var(--fg-muted); opacity: 0.6; }
	.target { width: 0.5rem; height: 0.5rem; background: var(--violet); opacity: 1; }
	:global([data-frame="0"]) .target { animation: ping 1.4s 0.6s ease-out 2 both; }

	.body { display: grid; min-height: 15rem; align-items: center; min-width: 0; }
	.pane { display: grid; gap: 0.75rem; min-width: 0; animation: rise 0.5s var(--ease-out) both; }
	.target-line { display: flex; align-items: center; gap: 0.6rem; font: 500 1.35rem var(--font-mono); letter-spacing: -0.02em; }
	.target-line b { color: var(--violet); font-weight: 500; }
	.target-line em { padding: 0.1rem 0.45rem; border: 1px solid var(--border); border-radius: 0.3rem; color: var(--fg-muted); font: 0.64rem var(--font-mono); font-style: normal; }
	.banner { justify-self: start; padding: 0.5rem 0.7rem; border-left: 2px solid var(--violet); background: var(--bg-raised); font: 0.74rem var(--font-mono); color: var(--fg-soft); animation: type 1s 0.6s steps(28) both; }
	.meta { font: 0.66rem/1.5 var(--font-mono); color: var(--fg-muted); overflow-wrap: anywhere; }
	.meta b { color: var(--fg-soft); font-weight: 500; }
	.pane > .meta:last-child:not(.result) { animation: rise 0.4s 1.7s var(--ease-out) both; }
	.cpe { font: 0.78rem var(--font-mono); color: var(--fg); overflow-wrap: anywhere; animation: type 1.1s 0.2s steps(36) both; }
	.cpe span { color: var(--fg-muted); }

	.cands { display: grid; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
	.cands li { position: relative; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.2rem 0.65rem; padding: 0.55rem 0.75rem; border: 1px solid var(--border); border-radius: 0.4rem; background: var(--bg-raised); overflow: hidden; animation: slide 0.45s calc(1.3s + var(--k) * 0.18s) var(--ease-out) both; }
	.cands code { font: 500 0.74rem var(--font-mono); }
	.cands li > span { font: 0.62rem var(--font-mono); color: var(--fg-muted); }

	/* Verification: plain-language outcomes, one warm signal for what is real. */
	.checked li { grid-template-columns: auto 1fr auto; animation: none; }
	.icon { width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 1.5px solid var(--fg-muted); animation: pop 0.35s calc(0.9s + var(--k) * 0.45s) var(--ease-out) both; }
	.checked .state { font-size: 0.66rem; animation: pop 0.35s calc(0.9s + var(--k) * 0.45s) var(--ease-out) both; }
	.checked small { grid-column: 2 / -1; font: 0.62rem/1.45 var(--font-mono); color: var(--fg-muted); animation: fade 0.3s calc(1s + var(--k) * 0.45s) both; }
	.scan { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, oklch(0.7 0.16 290 / 0.18), transparent); transform: translateX(-100%); animation: scan 0.7s calc(0.25s + var(--k) * 0.45s) ease-in-out both; pointer-events: none; }
	.s-confirmed { border-color: color-mix(in oklch, var(--signal) 45%, var(--border)); box-shadow: inset 2px 0 0 var(--signal); }
	.s-confirmed .icon { border-color: var(--signal); background: var(--signal); }
	.s-confirmed .state { color: var(--signal); font-weight: 600; }
	.s-confirmed .evidence { color: var(--fg-soft); }
	.s-inconclusive .icon { border-style: dashed; }
	.s-clear { opacity: 0.6; }
	.s-clear .icon { height: 1.5px; border: 0; border-radius: 2px; background: var(--fg-muted); }
	.result { color: var(--fg-soft); animation: rise 0.4s 2.4s var(--ease-out) both; }

	/* The horizon: a path drawn only from verified pieces. */
	.next { justify-self: start; padding: 0.15rem 0.55rem; border: 1px dashed var(--violet); border-radius: 999px; font: 0.62rem var(--font-mono); color: var(--violet); }
	.path { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.6rem; margin: 0.4rem 0; padding: 0; list-style: none; }
	.path li { position: relative; display: grid; align-content: start; gap: 0.3rem; padding: 0.7rem 0.75rem; border: 1px solid var(--border); border-radius: 0.45rem; background: var(--bg-raised); animation: rise 0.45s calc(0.3s + var(--k) * 0.45s) var(--ease-out) both; }
	.path li + li::before { content: ""; position: absolute; right: calc(100% + 0.2rem); top: 50%; width: 1.2rem; height: 1px; background: var(--violet); transform-origin: left; animation: grow 0.35s calc(0.15s + var(--k) * 0.45s) both; }
	.path strong { font: 500 0.78rem var(--font-mono); }
	.path small { font: 0.6rem/1.4 var(--font-mono); color: var(--fg-muted); }
	.path li:nth-child(2) small { color: var(--signal); }
	.crown { border-color: color-mix(in oklch, var(--signal) 45%, var(--border)); }

	@keyframes spin { to { transform: rotate(1turn); } }
	@keyframes ping { 0% { box-shadow: 0 0 0 0 oklch(0.7 0.16 290 / 0.7); } 100% { box-shadow: 0 0 0 14px oklch(0.7 0.16 290 / 0); } }
	@keyframes rise { from { opacity: 0; transform: translateY(8px); } }
	@keyframes slide { from { opacity: 0; transform: translateX(14px); } }
	@keyframes fade { from { opacity: 0; } }
	@keyframes pop { from { opacity: 0; transform: scale(0.8); } }
	@keyframes grow { from { transform: scaleX(0); } }
	@keyframes scan { to { transform: translateX(100%); } }
	@keyframes type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

	@media (prefers-reduced-motion: reduce) { .sg *, .sg *::before { animation: none !important; transition: none !important; } .scan { display: none; } }
	@media (max-width: 42rem) {
		.sg { grid-template-columns: 1fr; gap: 1rem; }
		.radar { width: 8.5rem; justify-self: center; }
		.target-line { font-size: 1.05rem; }
		.path { grid-template-columns: 1fr; gap: 0.9rem; }
		.path li + li::before { right: auto; left: 1.2rem; top: auto; bottom: calc(100% + 0.1rem); width: 1px; height: 0.7rem; transform-origin: top; }
	}
</style>
