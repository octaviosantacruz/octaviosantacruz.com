---
import type { Locale } from "../i18n/translations";
import SwitchboardScene from "./scenes/SwitchboardScene.astro";
import CustodiaScene, { type Plane } from "./scenes/CustodiaScene.astro";
import SigeaScene from "./scenes/SigeaScene.astro";

interface Props { kind: "switchboard" | "sigea" | "custodia"; locale: Locale }
const { kind, locale } = Astro.props;
const es = locale === "es";
const t = (en: string, esText: string) => (es ? esText : en);
const common = es
	? { pause: "Pausar", play: "Reproducir", example: "Secuencia ilustrativa · datos ficticios", stages: "Pasos de la explicación" }
	: { pause: "Pause", play: "Play", example: "Illustrative sequence · fictional data", stages: "Explanation steps" };

// Custodia: one correlation per plane, drawn on a ring of tools. Categories,
// not vendors: the product joins whatever tool fills each role. Records and
// findings are fictional.
const planes: Plane[] = [
	{ step: t("Devices", "Equipos"), verdict: "gap",
		a: { node: "dlp", record: t("alice · 2.1 GB upload", "alice · subida 2,1 GB") },
		b: { node: "edr", record: t("ALICE-LT01 · no agent", "ALICE-LT01 · sin agente") },
		finding: t("Alice moves data from a laptop no agent protects.", "Alice mueve datos desde una laptop que ningún agente protege."),
		out: es ? ["Cobertura", "UEBA", "Comportamiento"] : ["Coverage", "UEBA", "Behaviour"],
		q: t("DLP and EDR together give coverage, user behaviour and a digital x-ray of each person.", "DLP y EDR juntos dan cobertura, comportamiento del usuario y una radiografía digital de cada persona.") },
	{ step: t("Servers", "Servidores"), verdict: "gap",
		a: { node: "pam", record: t("db-07 · 3 local admins", "db-07 · 3 admins locales") },
		b: { node: "scan", record: t("db-07 · weak password", "db-07 · clave débil") },
		finding: t("db-07 has privileged accounts outside the vault, one with a guessable password.", "db-07 tiene cuentas privilegiadas fuera del vault, una con clave adivinable."),
		out: es ? ["Alcance", "Cuentas", "Claves débiles"] : ["Reach", "Accounts", "Weak passwords"],
		q: t("The scanner widens PAM's reach; a password scan from PAM finds the accounts, the scanner flags the weak ones.", "El escáner amplía el alcance del PAM; un password scan desde PAM encuentra las cuentas y el escáner marca las débiles.") },
	{ step: "Vulns", verdict: "gap",
		a: { node: "cloud", record: t("web-02 · internet-facing", "web-02 · expuesto a internet") },
		b: { node: "scan", record: "web-02 · CVE-2021-41773" },
		finding: t("web-02 is exposed and vulnerable: fix it first.", "web-02 está expuesto y es vulnerable: va primero."),
		out: es ? ["Contexto cloud", "Evidencia en host", "Prioridad"] : ["Cloud context", "Host evidence", "Priority"],
		q: t("Cloud context and host evidence on the same finding turn a long list into a priority.", "Contexto cloud y evidencia del host sobre el mismo hallazgo convierten una lista larga en una prioridad.") },
	{ step: t("Data", "Datos"), verdict: "gap",
		a: { node: "dspm", record: t("finance/ · card numbers", "finanzas/ · tarjetas") },
		b: { node: "dlp", record: t("payroll.xlsx · leaving", "nomina.xlsx · saliendo") },
		finding: t("Sensitive data found at rest is the same data leaving in motion.", "El dato sensible que está en reposo es el mismo que sale en movimiento."),
		out: es ? ["En reposo", "En movimiento", "Fuga"] : ["At rest", "In motion", "Leak"],
		q: t("DSPM knows where sensitive data lives; DLP sees where it goes. Together they show a leak.", "El DSPM sabe dónde vive el dato sensible; el DLP ve a dónde va. Juntos muestran una fuga.") },
	{ step: "Web", verdict: "partial",
		a: { node: "cloud", record: t("api.acme · public", "api.acme · público") },
		b: { node: "waf", record: t("api.acme · 1.2k probes/day", "api.acme · 1,2k sondeos/día") },
		finding: t("A public API probed every day, with its owner and exposure in one view.", "Una API pública sondeada todos los días, con su dueño y exposición en una vista."),
		out: es ? ["Exposición", "Navegación", "Patrones"] : ["Exposure", "Browsing", "Patterns"],
		q: t("Cloud inventory with edge and browsing data shows what is exposed and how people move around it.", "El inventario cloud con datos del borde y la navegación muestra qué está expuesto y cómo se mueve la gente alrededor.") },
	{ step: t("Identity", "Identidad"), verdict: "gap",
		a: { node: "iam", record: t("carol · offboarded", "carol · dada de baja") },
		b: { node: "all", record: t("carol · active in PAM, SSE", "carol · activa en PAM, SSE") },
		finding: t("Carol left in May; two tools still let her in.", "Carol se fue en mayo; dos herramientas todavía la dejan entrar."),
		out: es ? ["Quién", "A qué", "Visión 360"] : ["Who", "To what", "360 view"],
		q: t("Identity across every tool answers who in the company has access to what: the 360 view.", "La identidad cruzada con cada herramienta responde quién de la empresa tiene acceso a qué: la visión 360.") },
];

const scenes = {
	switchboard: {
		title: t("Access that understands context", "Un acceso que entiende el contexto"),
		duration: 8000,
		steps: es ? ["Identidad", "Contexto", "Just-in-time", "Explicado"] : ["Identity", "Context", "Just-in-time", "Explained"],
		details: es ? [
			"Hoy: la app está detrás de Switchboard. Ana se autentica con su passkey, la política la deja pasar y la app se abre por el túnel hacia casa.",
			"Próximo: señales de contexto. Ana aparece en Madrid 12 minutos después de Asunción; en vez de dejarla pasar, Switchboard pide una passkey nueva y confirmación en el teléfono.",
			"Próximo: nadie tiene acceso permanente. Leo pide entrar a db-prod, la aprobación llega al teléfono y el acceso vence solo, con la sesión grabada.",
			"Próximo: cada decisión se explica en lenguaje claro y queda en un log de transparencia que se puede verificar: nada se reescribe en silencio.",
		] : [
			"Today: the app sits behind Switchboard. Ana authenticates with her passkey, the policy lets her in and the app opens through the tunnel home.",
			"Next: context signals. Ana appears in Madrid 12 minutes after Asunción; instead of letting her through, Switchboard asks for a fresh passkey and confirmation on her phone.",
			"Next: no one keeps standing access. Leo requests db-prod, the approval reaches a phone and access expires on its own, with the session recorded.",
			"Next: every decision is explained in plain language and lands in a verifiable transparency log: nothing is rewritten silently.",
		],
	},
	custodia: {
		title: t("Every tool, correlated through Custodia", "Cada herramienta, correlacionada a través de Custodia"),
		duration: 8000,
		steps: planes.map(p => p.step),
		details: planes.map(p => p.q),
	},
	sigea: {
		title: t("Only what a probe confirms is reported", "Solo se reporta lo que un probe confirma"),
		duration: 8500,
		steps: es ? ["Descubrir", "Correlacionar", "Verificar", "Camino"] : ["Discover", "Correlate", "Verify", "Path"],
		details: es ? [
			"El agente encuentra un puerto abierto y un detector lee el banner: Apache HTTP Server 2.4.49.",
			"La API de NVD traduce el producto a su CPE, y ese CPE trae vulnerabilidades candidatas.",
			"Un probe valida cada candidata contra el servicio real: confirmada, inconclusa o no afectada. Solo se reporta lo confirmado, con su evidencia, y así bajan los falsos positivos.",
			"Próximo: con hallazgos confirmados y alcanzabilidad verificada, SIGEA arma caminos de ataque: desde internet hasta el dato que importa.",
		] : [
			"The agent finds an open port and a detector reads the banner: Apache HTTP Server 2.4.49.",
			"The NVD API maps the product to its CPE, and that CPE brings candidate vulnerabilities.",
			"A probe checks each candidate against the real service: confirmed, inconclusive or not affected. Only what is confirmed is reported, with its evidence, so false positives drop.",
			"Next: with confirmed findings and verified reachability, SIGEA builds attack paths, from the internet to the data that matters.",
		],
	},
};
const scene = scenes[kind];
---

<!-- Each scene wears its product's own identity and tells one idea through
     motion. Without JavaScript or with reduced motion, every step is a
     complete, still picture. -->
<figure class="project-scene" data-scene data-kind={kind} data-frame="0" data-duration={scene.duration} style={`--duration: ${scene.duration}`}
	data-details={JSON.stringify(scene.details)} data-pause={common.pause} data-play={common.play}>
	<div class="scene-topline">
		<p>{scene.title}</p>
		<button class="scene-toggle" type="button" aria-pressed="false" hidden>{common.pause}</button>
	</div>
	<div class="stage">
		{kind === "switchboard" && <SwitchboardScene locale={locale} />}
		{kind === "custodia" && <CustodiaScene locale={locale} planes={planes} />}
		{kind === "sigea" && <SigeaScene locale={locale} />}
	</div>
	<div class="scene-controls" role="group" aria-label={common.stages} style={`--steps: ${scene.steps.length}; --cols: ${scene.steps.length > 4 ? 3 : scene.steps.length === 4 ? 2 : scene.steps.length}`} hidden>
		{scene.steps.map((step, i) => <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-frame-select={i}><span class="bar" aria-hidden="true"></span><span class="num" aria-hidden="true">{i + 1}</span>{step}</button>)}
	</div>
	<figcaption>
		<p class="scene-description">{scene.details[0]}</p>
		<span class="scene-example">{common.example}</span>
	</figcaption>
</figure>

<script>
	for (const scene of document.querySelectorAll<HTMLElement>("[data-scene]")) {
		const details: string[] = JSON.parse(scene.dataset.details!);
		const buttons = [...scene.querySelectorAll<HTMLButtonElement>("[data-frame-select]")];
		const toggle = scene.querySelector<HTMLButtonElement>(".scene-toggle")!;
		const description = scene.querySelector<HTMLElement>(".scene-description")!;
		const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let frame = Number(scene.dataset.frame);
		const initial = frame;
		let timer = 0;
		let paused = false;
		let visible = false;
		const schedule = () => {
			clearTimeout(timer);
			const running = !paused && visible && !motion.matches && !document.hidden;
			scene.classList.toggle("is-playing", running);
			if (running) timer = window.setTimeout(() => show((frame + 1) % buttons.length), Number(scene.dataset.duration));
		};
		const show = (index: number) => {
			frame = index;
			scene.dataset.frame = String(index);
			description.textContent = details[index];
			buttons.forEach((button, i) => button.setAttribute("aria-pressed", String(i === index)));
			schedule();
		};
		const pause = () => {
			paused = true;
			toggle.textContent = scene.dataset.play!;
			toggle.setAttribute("aria-pressed", "true");
		};
		buttons.forEach((button, i) => button.addEventListener("click", () => {
			pause();
			description.setAttribute("aria-live", "polite");
			show(i);
		}));
		toggle.addEventListener("click", () => {
			if (paused) {
				paused = false;
				toggle.textContent = scene.dataset.pause!;
				toggle.setAttribute("aria-pressed", "false");
				description.setAttribute("aria-live", "off");
			} else pause();
			schedule();
		});
		const updateMotion = () => {
			toggle.hidden = motion.matches;
			if (motion.matches) show(initial);
			else schedule();
		};
		motion.addEventListener("change", updateMotion);
		document.addEventListener("visibilitychange", schedule);
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			schedule();
		}, { threshold: 0.25 }).observe(scene);
		scene.querySelector<HTMLElement>(".scene-controls")!.hidden = false;
		updateMotion();
	}
</script>

<style>
	.project-scene {
		--ease-out: cubic-bezier(.2, .7, .2, 1);
		--scene-accent: var(--accent);
		position: relative; min-width: 0; margin: 0; padding: 1.4rem; border: 1px solid var(--border); border-radius: 1rem; overflow: hidden;
		background: radial-gradient(120% 80% at 50% 0%, color-mix(in oklch, var(--scene-accent) 7%, transparent), transparent 60%), radial-gradient(oklch(1 0 0 / 0.045) 1px, transparent 1px) 0 0 / 18px 18px, oklch(0.135 0.006 260);
	}
	[data-kind="switchboard"] { --scene-accent: oklch(0.83 0.13 75); }
	[data-kind="custodia"] { --scene-accent: oklch(0.91 0.19 124); }
	[data-kind="sigea"] { --scene-accent: oklch(0.7 0.16 290); }
	.scene-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.75rem; }
	.scene-topline p { font-size: 0.9rem; font-weight: 600; color: var(--fg-soft); }
	.scene-toggle { flex-shrink: 0; min-height: 2.75rem; padding: 0.4rem 0.8rem; border: 1px solid var(--border); border-radius: 999px; background: oklch(0.15 0.006 260 / 0.8); color: var(--fg-soft); font: 0.7rem var(--font-mono); cursor: pointer; }
	.scene-toggle:hover { border-color: var(--scene-accent); color: var(--fg); }

	/* One fixed stage; each step replaces the previous one in place. */
	.stage { display: grid; place-items: center; min-height: 21rem; margin: 1.2rem 0; }
	:global([data-frame="0"] [data-only]:not([data-only="0"])), :global([data-frame="1"] [data-only]:not([data-only="1"])),
	:global([data-frame="2"] [data-only]:not([data-only="2"])), :global([data-frame="3"] [data-only]:not([data-only="3"])),
	:global([data-frame="4"] [data-only]:not([data-only="4"])), :global([data-frame="5"] [data-only]:not([data-only="5"])) { display: none !important; }
	:global([data-frame="0"] [data-not="0"]), :global([data-frame="1"] [data-not="1"]), :global([data-frame="2"] [data-not="2"]), :global([data-frame="3"] [data-not="3"]) { display: none !important; }

	/* Step controls double as a progress bar while playing. */
	.scene-controls { display: grid; grid-template-columns: repeat(var(--steps), minmax(0, 1fr)); gap: 0.5rem; }
	.scene-controls button { position: relative; display: flex; align-items: center; gap: 0.5rem; min-width: 0; min-height: 2.75rem; padding: 0.55rem 0.4rem 0.45rem; border: 0; background: transparent; color: var(--fg-muted); font: 500 0.76rem var(--font-sans); text-align: left; cursor: pointer; transition: color 0.2s; }
	.scene-controls .bar { position: absolute; left: 0; right: 0; top: 0; height: 2px; border-radius: 2px; background: var(--border); overflow: hidden; }
	.scene-controls .bar::after { content: ""; position: absolute; inset: 0; background: var(--scene-accent); transform: scaleX(0); transform-origin: left; }
	.scene-controls button[aria-pressed="true"] { color: var(--fg); }
	.scene-controls button[aria-pressed="true"] .bar::after { transform: scaleX(1); }
	.is-playing .scene-controls button[aria-pressed="true"] .bar::after { animation: progress calc(var(--duration) * 1ms) linear both; }
	.scene-controls .num { font: 0.64rem var(--font-mono); color: var(--fg-muted); }
	.scene-controls button:hover { color: var(--fg); }
	.scene-description { min-height: 3.2em; margin-top: 0.9rem; font-size: 0.86rem; line-height: 1.55; color: var(--fg-soft); text-wrap: pretty; }
	.scene-example { display: block; margin-top: 0.7rem; font: 0.64rem var(--font-mono); color: var(--fg-muted); }
	@keyframes progress { from { transform: scaleX(0); } }

	@media (max-width: 42rem) {
		.project-scene { padding: 1rem; }
		.scene-topline { align-items: start; }
		.scene-toggle { max-width: 7.5rem; font-size: 0.65rem; }
		.stage { min-height: 18rem; }
		.scene-controls { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); row-gap: 0.2rem; }
		.scene-controls button { gap: 0.35rem; font-size: 0.7rem; padding-inline: 0.2rem; }
		.scene-description { min-height: 4.7em; }
	}
	@media (prefers-reduced-motion: reduce) { .scene-controls .bar::after { animation: none !important; } }
	@media (max-width: 26rem) {
		.scene-controls .num { display: none; }
		.scene-topline { gap: 0.5rem; }
		.scene-topline p { min-width: 0; overflow-wrap: anywhere; }
	}
</style>
