---
import type { Locale } from "../i18n/translations";

interface Props { kind: "switchboard" | "sigea" | "custodia"; locale: Locale }
const { kind, locale } = Astro.props;
const es = locale === "es";
const t = (en: string, esText: string) => (es ? esText : en);
const common = es
	? { pause: "Pausar", play: "Reproducir", example: "Secuencia ilustrativa · datos ficticios", stages: "Pasos de la explicación", next: "Hacia donde va" }
	: { pause: "Pause", play: "Play", example: "Illustrative sequence · fictional data", stages: "Explanation steps", next: "Where it is going" };
const scenes = {
	switchboard: {
		title: t("Seven checks, always in the same order", "Siete controles, siempre en el mismo orden"),
		steps: es ? ["Cabecera falsa", "Sin permiso", "Con permiso"] : ["Forged header", "No permission", "Allowed"],
		details: es ? [
			"Alguien envía un header de identidad inventado. La primera etapa lo descarta antes de que cuente: queda como anónimo y se rechaza.",
			"Leo inicia sesión con su passkey, pero la ruta exige el grupo admins. Se rechaza en authorize con el motivo y las etapas siguientes no se ejecutan.",
			"Ana cruza las siete etapas. El conector, desde casa, ya tenía un túnel saliente abierto: el homelab no expone puertos. La app recibe la identidad verificada.",
		] : [
			"Someone sends an invented identity header. The first stage discards it before it counts: the request becomes anonymous and is refused.",
			"Leo signs in with his passkey, but the route requires the admins group. He is refused at authorize with the reason, and later stages never run.",
			"Ana crosses all seven stages. The connector at home already holds an outbound tunnel: the homelab exposes no ports. The app receives the verified identity.",
		],
	},
	custodia: {
		title: t("One person, every tool, an honest answer", "Una persona, cada herramienta, una respuesta honesta"),
		steps: es ? ["Brecha", "Desconocido", "Otra fuente"] : ["Gap", "Unknown", "Another source"],
		details: es ? [
			"Alice tiene acceso privilegiado en CyberArk y Netskope la ve sin equipos, con una captura completa y reciente. La regla CONN-001 concluye una brecha de señal del cliente.",
			"Ben tiene el mismo patrón, pero la captura de Netskope es parcial y tiene 12 días. Una ausencia no prueba nada: la conclusión es desconocido, no brecha.",
			"Cada fuente nueva aporta su propia evidencia y puede cambiar una respuesta. Aún no existe el adaptador de CrowdStrike: esto muestra hacia dónde va el producto.",
		] : [
			"Alice has privileged access in CyberArk, and Netskope sees her with no devices in a complete, recent capture. Rule CONN-001 concludes a client-signal gap.",
			"Ben has the same pattern, but the Netskope capture is partial and 12 days old. An absence proves nothing: the answer is unknown, not a gap.",
			"Each new source brings its own evidence and can change an answer. The CrowdStrike adapter does not exist yet: this shows where the product is going.",
		],
	},
	sigea: {
		title: t("Authorization stays with the network being scanned", "La autorización queda del lado de la red escaneada"),
		steps: es ? ["Política local", "Sobrevive", "Qué cambió"] : ["Local policy", "Survives", "What changed"],
		details: es ? [
			"El servidor puede pedir un scan, pero la política vive en el agente. Acepta el rango permitido y rechaza el que queda fuera: nadie puede ampliarla desde arriba.",
			"El resultado se guarda en un spool durable antes de subir. Si el agente muere a mitad de camino, retoma y el servidor registra el recibo una sola vez.",
			"Una captura parcial no genera bajas. Con dos capturas completas, 22/SSH deja de observarse y cada cambio apunta a la observación que lo originó.",
		] : [
			"The server can request a scan, but the policy lives in the agent. It accepts the allowed range and refuses the one outside it: no one can widen it from above.",
			"The result is saved to a durable spool before upload. If the agent dies midway it resumes, and the server records the receipt only once.",
			"A partial capture produces no removals. With two complete captures, 22/SSH is no longer observed and each change points to the observation behind it.",
		],
	},
};
const scene = scenes[kind];
const stages: { name: string; a: string; b: string; c: string }[] = [
	{ name: "trust", a: "hit", b: "pass", c: "pass" },
	{ name: "ratelimit", a: "pass", b: "pass", c: "pass" },
	{ name: "shield", a: "pass", b: "pass", c: "pass" },
	{ name: "identify", a: "hit", b: "hit", c: "hit" },
	{ name: "authorize", a: "stop", b: "stop", c: "hit" },
	{ name: "route", a: "skip", b: "skip", c: "hit" },
	{ name: "forward", a: "skip", b: "skip", c: "hit" },
];
---

<!-- Each scene follows how its product really works, then shows the end goal
     as dashed, clearly not-yet-built elements. Every label remains present
     while playing; animation moves attention, not layout. -->
<figure class="project-scene" data-scene data-kind={kind} data-frame="2"
	data-details={JSON.stringify(scene.details)} data-pause={common.pause} data-play={common.play}>
	<div class="scene-topline">
		<p>{scene.title}</p>
		<button class="scene-toggle" type="button" aria-pressed="false" hidden>{common.pause}</button>
	</div>

	{kind === "switchboard" && <div class="sb">
		<div class="sb-line">
			<div class="sb-end"><span class="node-label">{t("Visitor", "Visitante")}</span>
				<strong class="sb-who"><span data-only="0">{t("anonymous", "anónimo")}</span><span data-only="1">Leo</span><span data-only="2">Ana</span></strong></div>
			<ol class="sb-stages">{stages.map((st, i) => <li class="stage" data-a={st.a} data-b={st.b} data-c={st.c}><span class="stage-n" aria-hidden="true">{i + 1}</span>{st.name}</li>)}</ol>
			<div class="sb-end sb-home"><span class="node-label">{t("App at home", "App en casa")}</span>
				<strong>{t("outbound tunnel", "túnel saliente")}</strong><span class="node-detail">{t("no open ports", "sin puertos abiertos")}</span></div>
		</div>
		<div class="sb-log" aria-hidden="false">
			<p class="node-label">{t("Every stage records its decision", "Cada etapa registra su decisión")}</p>
			<ul data-only="0"><li><b>trust</b> strip X-Auth-Request-User <i>{t("sent by the client", "enviado por el cliente")}</i></li><li><b>identify</b> {t("no session → anonymous", "sin sesión → anónimo")}</li><li class="neg"><b>authorize</b> deny · {t("identity required", "identidad requerida")}</li></ul>
			<ul data-only="1"><li><b>identify</b> leo · passkey</li><li class="neg"><b>authorize</b> deny · group:admins {t("missing", "ausente")}</li><li class="mute"><b>route · forward</b> {t("not reached", "no se ejecutan")}</li></ul>
			<ul data-only="2"><li><b>identify</b> ana · passkey</li><li class="pos"><b>authorize</b> allow · group:admins</li><li class="pos"><b>route · forward</b> {t("tunnel to the homelab · verified identity injected", "túnel al homelab · identidad verificada inyectada")}</li></ul>
		</div>
		<p class="next-strip"><span>{common.next}</span>{t("The app verifies a signed assertion from Switchboard instead of trusting headers, starting with Custodia.", "La app verifica una aserción firmada por Switchboard en vez de confiar en headers, empezando por Custodia.")}</p>
	</div>}

	{kind === "custodia" && <div class="cu">
		<div class="cu-row cu-alice">
			<div class="cu-person"><span class="cu-avatar" aria-hidden="true">AM</span><strong>Alice Morgan</strong></div>
			<div class="cu-cell"><span class="node-label">CyberArk</span><strong>{t("Privileged access", "Acceso privilegiado")}</strong><span class="node-detail">Safe ACME-DEV</span></div>
			<div class="cu-cell"><span class="node-label">Netskope</span><strong>{t("User · 0 devices", "Usuaria · 0 equipos")}</strong><span class="node-detail">{t("complete · 2 days", "completa · 2 días")}</span></div>
			<div class="cu-cell cu-next"><span class="node-label">CrowdStrike <em>{t("next", "próximo")}</em></span>
				<strong><span data-only="2">ALICE-LT01</span><span data-not="2">{t("no adapter yet", "sin adaptador aún")}</span></strong><span class="node-detail"><span data-only="2">{t("sensor active", "sensor activo")}</span></span></div>
			<div class="cu-verdict"><span class="node-label">{t("Answer", "Respuesta")}</span>
				<strong class="v-gap" data-not="2"><i aria-hidden="true"></i>{t("Gap", "Brecha")}</strong>
				<strong class="v-ok" data-only="2"><i aria-hidden="true"></i>{t("Covered", "Cubierta")}</strong>
				<span class="node-detail"><span data-not="2">CONN-001 v1</span><span data-only="2">{t("illustration", "ilustración")}</span></span></div>
		</div>
		<div class="cu-row cu-ben">
			<div class="cu-person"><span class="cu-avatar" aria-hidden="true">BR</span><strong>Ben Ruiz</strong></div>
			<div class="cu-cell"><span class="node-label">CyberArk</span><strong>{t("Privileged access", "Acceso privilegiado")}</strong><span class="node-detail">Safe ACME-FIN</span></div>
			<div class="cu-cell cu-stale"><span class="node-label">Netskope</span><strong>{t("User · 0 devices", "Usuario · 0 equipos")}</strong><span class="node-detail">{t("partial · 12 days old", "parcial · 12 días")}</span></div>
			<div class="cu-cell cu-next"><span class="node-label">CrowdStrike <em>{t("next", "próximo")}</em></span><strong>{t("not observed", "sin observación")}</strong><span class="node-detail">{t("an absence, not a gap", "una ausencia, no una brecha")}</span></div>
			<div class="cu-verdict"><span class="node-label">{t("Answer", "Respuesta")}</span>
				<strong class="v-unk"><i aria-hidden="true"></i>{t("Unknown", "Desconocido")}</strong>
				<span class="node-detail">{t("stale evidence", "evidencia vieja")}</span></div>
		</div>
		<p class="next-strip"><span>{common.next}</span>{t("BigID, Cortex XDR, Tenable and firewalls as new columns, each one a source with its own contract. Inventories are never merged.", "BigID, Cortex XDR, Tenable y firewalls como columnas nuevas, cada una una fuente con su propio contrato. Los inventarios nunca se fusionan.")}</p>
	</div>}

	{kind === "sigea" && <div class="sg">
		<div class="sg-sides"><span class="node-label">{t("Your network · agent + local policy", "Tu red · agente + política local")}</span><span class="sg-wire" aria-hidden="true">{t("signed requests", "pedidos firmados")}</span><span class="node-label">{t("Server · inventory + history", "Servidor · inventario + historial")}</span></div>
		<div class="sg-stage">
			<div class="sg-frame" data-only="0">
				<div class="sg-card"><span class="node-label">policy</span><code>allow 192.0.2.0/24</code><code>ports 1–1024</code><code>profile nmap-safe</code></div>
				<div class="sg-list">
					<div class="sg-job pos"><span class="node-label">{t("server asks", "el servidor pide")}</span><strong>192.0.2.0/24</strong><em>{t("accepted", "aceptado")}</em></div>
					<div class="sg-job neg"><span class="node-label">{t("server asks", "el servidor pide")}</span><strong>198.51.100.0/24</strong><em>{t("refused · outside local policy", "rechazado · fuera de la política local")}</em></div>
				</div>
			</div>
			<div class="sg-frame" data-only="1">
				<div class="sg-card"><span class="node-label">spool</span><strong>{t("2 results saved on disk", "2 resultados guardados en disco")}</strong><span class="node-detail">scan → spool → upload</span><span class="sg-kill">kill -9</span></div>
				<div class="sg-list">
					<div class="sg-job pos"><span class="node-label">{t("agent restarts", "el agente reinicia")}</span><strong>{t("resumes the upload", "retoma la subida")}</strong><em>receipt r-0412</em></div>
					<div class="sg-job"><span class="node-label">{t("replayed request", "pedido repetido")}</span><strong>r-0412</strong><em>{t("recorded once · no duplicate", "registrado una vez · sin duplicado")}</em></div>
				</div>
			</div>
			<div class="sg-frame" data-only="2">
				<div class="sg-card sg-scans"><span class="node-label">{t("captures of 192.0.2.10", "capturas de 192.0.2.10")}</span>
					<div><span>{t("1 complete", "1 completa")}</span><code>22 · 443</code></div>
					<div class="sg-partial"><span>{t("2 partial", "2 parcial")}</span><code>443</code></div>
					<div><span>{t("3 complete", "3 completa")}</span><code>443 · 8443</code></div></div>
				<div class="sg-list">
					<div class="sg-job"><span class="node-label">1 → 2</span><strong>{t("no removals", "sin bajas")}</strong><em>{t("a partial capture cannot justify them", "una parcial no las justifica")}</em></div>
					<div class="sg-job neg"><span class="node-label">1 → 3</span><strong>22 / SSH {t("no longer observed", "ya no observado")}</strong><em>{t("evidence → raw observation", "evidencia → observación original")}</em></div>
					<div class="sg-job pos"><span class="node-label">1 → 3</span><strong>8443 / HTTPS {t("new", "nuevo")}</strong><em>{t("evidence → raw observation", "evidencia → observación original")}</em></div>
				</div>
			</div>
		</div>
		<p class="next-strip"><span>{common.next}</span>{t("Open probes written by the community → CVE matches that explain themselves → attack paths built from verified findings.", "Probes abiertos escritos por la comunidad → coincidencias CVE que se explican solas → caminos de ataque a partir de hallazgos verificados.")}</p>
	</div>}

	<div class="scene-controls" role="group" aria-label={common.stages} hidden>
		{scene.steps.map((step, i) => <button type="button" aria-pressed={i === 2 ? "true" : "false"} data-frame-select={i}><span aria-hidden="true">{i + 1}</span>{step}</button>)}
	</div>
	<figcaption>
		<p class="scene-description">{scene.details[2]}</p>
		<span class="scene-example">{common.example}</span>
	</figcaption>
</figure>

<script>
	for (const scene of document.querySelectorAll<HTMLElement>("[data-scene]")) {
		const details: string[] = JSON.parse(scene.dataset.details!);
		const buttons = [...scene.querySelectorAll<HTMLButtonElement>("[data-frame-select]")];
		const toggle = scene.querySelector<HTMLButtonElement>(".scene-toggle")!;
		const description = scene.querySelector<HTMLElement>(".scene-description")!;
		const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let frame = 2;
		let timer = 0;
		let paused = false;
		let visible = false;
		const schedule = () => {
			clearTimeout(timer);
			const running = !paused && visible && !motion.matches && !document.hidden;
			scene.classList.toggle("is-playing", running);
			if (running) timer = window.setTimeout(() => show((frame + 1) % buttons.length), 4200);
		};
		const show = (index: number) => {
			frame = index;
			scene.dataset.frame = String(index);
			description.textContent = details[index];
			buttons.forEach((button, i) => button.setAttribute("aria-pressed", String(i === index)));
			schedule();
		};
		const pause = () => {
			paused = true;
			toggle.textContent = scene.dataset.play!;
			toggle.setAttribute("aria-pressed", "true");
		};
		buttons.forEach((button, i) => button.addEventListener("click", () => {
			pause();
			description.setAttribute("aria-live", "polite");
			show(i);
		}));
		toggle.addEventListener("click", () => {
			if (paused) {
				paused = false;
				toggle.textContent = scene.dataset.pause!;
				toggle.setAttribute("aria-pressed", "false");
				description.setAttribute("aria-live", "off");
			} else pause();
			schedule();
		});
		const updateMotion = () => {
			toggle.hidden = motion.matches;
			if (motion.matches) show(2);
			else schedule();
		};
		motion.addEventListener("change", updateMotion);
		document.addEventListener("visibilitychange", schedule);
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			schedule();
		}, { threshold: 0.25 }).observe(scene);
		scene.querySelector<HTMLElement>(".scene-controls")!.hidden = false;
		updateMotion();
	}
</script>

<style>
	.project-scene { --scene-positive: oklch(0.82 0.07 155); --scene-negative: oklch(0.78 0.11 25); --scene-caution: oklch(0.83 0.13 75); min-width: 0; margin: 0; padding: 1.4rem; border: 1px solid var(--border); border-radius: 0.9rem; background: var(--bg); }
	.scene-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.75rem; }
	.scene-topline p { font-size: 0.9rem; font-weight: 600; color: var(--fg-soft); }
	.scene-toggle { flex-shrink: 0; min-height: 2.75rem; padding: 0.4rem 0.7rem; border: 1px solid var(--border); border-radius: 0.4rem; background: transparent; color: var(--fg-soft); font: 0.72rem var(--font-mono); cursor: pointer; }
	.scene-toggle:hover { border-color: var(--accent); color: var(--fg); }
	.node-label { font: 0.68rem/1.5 var(--font-mono); color: var(--fg-muted); }
	.node-detail { font: 0.68rem/1.5 var(--font-mono); color: var(--fg-muted); overflow-wrap: anywhere; }
	.sb, .cu, .sg { display: grid; gap: 1rem; margin: 1.1rem 0 1.2rem; min-height: 17rem; align-content: start; }

	/* Frame visibility: elements tagged for one frame, or for all but one. */
	[data-frame="0"] [data-only]:not([data-only="0"]), [data-frame="1"] [data-only]:not([data-only="1"]), [data-frame="2"] [data-only]:not([data-only="2"]) { display: none; }
	[data-frame="0"] [data-not="0"], [data-frame="1"] [data-not="1"], [data-frame="2"] [data-not="2"] { display: none; }
	.pos { --tone: var(--scene-positive); } .neg { --tone: var(--scene-negative); }

	/* The dashed strip is the end goal: everything inside is not built yet. */
	.next-strip { display: grid; gap: 0.3rem; padding: 0.8rem 1rem; border: 1px dashed var(--accent-line); border-radius: 0.55rem; font-size: 0.78rem; line-height: 1.55; color: var(--fg-soft); }
	.next-strip span { font: 0.66rem var(--font-mono); color: var(--accent); }

	/* Switchboard */
	.sb-line { display: grid; grid-template-columns: 6rem minmax(0, 1fr) 7.5rem; gap: 0.8rem; align-items: center; }
	.sb-end { display: grid; gap: 0.25rem; padding: 0.75rem; border: 1px solid var(--border); border-radius: 0.55rem; background: var(--bg-raised); }
	.sb-end strong { font-size: 0.85rem; line-height: 1.35; }
	.sb-stages { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.3rem; margin: 0; padding: 0; list-style: none; }
	.stage { display: grid; gap: 0.35rem; justify-items: center; padding: 0.6rem 0.1rem; border: 1px solid var(--border); border-radius: 0.45rem; background: var(--bg-raised); font: 0.58rem var(--font-mono); color: var(--fg-muted); transition: border-color 0.5s, color 0.5s, opacity 0.5s, background 0.5s; overflow-wrap: anywhere; text-align: center; }
	.stage-n { font-size: 0.66rem; color: var(--fg-muted); }
	[data-frame="0"] .stage[data-a="pass"], [data-frame="1"] .stage[data-b="pass"], [data-frame="2"] .stage[data-c="pass"] { color: var(--fg-soft); }
	[data-frame="0"] .stage[data-a="hit"], [data-frame="1"] .stage[data-b="hit"], [data-frame="2"] .stage[data-c="hit"] { border-color: var(--accent); color: var(--accent); background: var(--accent-dim); }
	[data-frame="0"] .stage[data-a="stop"], [data-frame="1"] .stage[data-b="stop"], [data-frame="2"] .stage[data-c="stop"] { border-color: var(--scene-negative); color: var(--scene-negative); background: oklch(0.78 0.11 25 / 0.08); }
	[data-frame="0"] .stage[data-a="skip"], [data-frame="1"] .stage[data-b="skip"], [data-frame="2"] .stage[data-c="skip"] { opacity: 0.35; border-style: dashed; }
	.sb-home { border-style: solid; }
	.sb-log { display: grid; gap: 0.5rem; padding: 0.9rem 1rem; border: 1px solid var(--border); border-radius: 0.55rem; background: var(--bg-raised); }
	.sb-log ul { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; font: 0.72rem/1.5 var(--font-mono); color: var(--fg-soft); }
	.sb-log b { display: inline-block; min-width: 5.2rem; margin-right: 0.4rem; color: var(--fg); font-weight: 500; }
	.sb-log i { color: var(--fg-muted); font-style: normal; }
	.sb-log .neg, .sb-log .neg b { color: var(--scene-negative); } .sb-log .pos, .sb-log .pos b { color: var(--scene-positive); } .sb-log .mute { color: var(--fg-muted); }

	/* Custodia */
	.cu-row { display: grid; grid-template-columns: 7.2rem repeat(3, minmax(0, 1fr)) 7.4rem; gap: 0.5rem; align-items: stretch; padding: 0.55rem; border: 1px solid var(--border); border-radius: 0.65rem; background: var(--bg-raised); transition: border-color 0.5s; }
	[data-frame="0"] .cu-alice, [data-frame="1"] .cu-ben, [data-frame="2"] .cu-alice { border-color: var(--accent-line); }
	.cu-person { display: grid; gap: 0.4rem; align-content: center; justify-items: start; font-size: 0.8rem; }
	.cu-avatar { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border: 1px solid var(--accent-line); border-radius: 50%; font: 0.7rem var(--font-mono); color: var(--accent); }
	.cu-cell, .cu-verdict { display: grid; gap: 0.2rem; align-content: start; min-width: 0; padding: 0.6rem; border: 1px solid var(--border); border-radius: 0.2rem; background: var(--bg); }
	.cu-cell strong { font-size: 0.78rem; line-height: 1.35; }
	.cu-cell em { color: var(--accent); font-style: normal; }
	.cu-next { border-style: dashed; border-color: var(--accent-line); }
	[data-frame="2"] .cu-alice .cu-next { border-style: solid; border-color: var(--accent); }
	.cu-stale .node-detail { color: var(--scene-caution); }
	.cu-verdict { border-color: transparent; background: transparent; }
	.cu-verdict strong { display: flex; align-items: center; gap: 0.45rem; font-size: 1.15rem; letter-spacing: -0.03em; line-height: 1.1; }
	.cu-verdict i { flex-shrink: 0; width: 0.7rem; height: 0.7rem; border: 2px solid currentColor; }
	.v-gap { color: var(--scene-negative); } .v-gap i { transform: rotate(45deg); }
	.v-ok { color: var(--scene-positive); } .v-ok i { border-radius: 50%; }
	.v-unk { color: var(--scene-caution); } .v-unk i { border-radius: 50%; border-style: dotted; }

	/* SIGEA */
	.sg-sides { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 0.8rem; align-items: center; }
	.sg-sides > span:last-child { text-align: right; }
	.sg-wire { padding: 0.15rem 0.6rem; border: 1px dashed var(--accent-line); border-radius: 999px; font: 0.62rem var(--font-mono); color: var(--accent); }
	.sg-stage { display: grid; }
	.sg-frame { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 0.8rem; align-items: start; }
	.sg-card, .sg-job { display: grid; gap: 0.3rem; padding: 0.8rem; border: 1px solid var(--border); border-radius: 0.55rem; background: var(--bg-raised); }
