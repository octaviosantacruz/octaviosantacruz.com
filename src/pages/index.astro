---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, NAV_LINKS } from "../consts";
---

<BaseLayout>
	<header>
		<nav aria-label="Navegación principal">
			<a href="#top" class="brand">{SITE.name}</a>
			<ul>
				{
					NAV_LINKS.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</header>

	<main id="top">
		<section id="sobre-mi" aria-labelledby="sobre-mi-heading">
			<h1 id="sobre-mi-heading">Sobre mí</h1>
			<p><!-- TODO: bio real --></p>
		</section>

		<section id="experiencia" aria-labelledby="experiencia-heading">
			<h2 id="experiencia-heading">Experiencia</h2>
			<p><!-- TODO: experiencia laboral --></p>
		</section>

		<section id="certificaciones" aria-labelledby="certificaciones-heading">
			<h2 id="certificaciones-heading">Certificaciones</h2>
			<p><!-- TODO: certificaciones --></p>
		</section>

		<section id="proyectos" aria-labelledby="proyectos-heading">
			<h2 id="proyectos-heading">Proyectos</h2>
			<p><!-- TODO: proyectos destacados --></p>
		</section>

		<section id="contacto" aria-labelledby="contacto-heading">
			<h2 id="contacto-heading">Contacto</h2>
			<p><!-- TODO: información de contacto --></p>
		</section>
	</main>

	<footer>
		<p>&copy; {new Date().getFullYear()} {SITE.name}</p>
	</footer>
</BaseLayout>
