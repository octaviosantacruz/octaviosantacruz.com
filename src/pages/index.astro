---
import BaseLayout from "../layouts/BaseLayout.astro";
import TriangleMark from "../components/TriangleMark.astro";
import { SITE, PERSON, NAV_LINKS } from "../consts";
---

<BaseLayout>
	<a class="skip-link" href="#contenido">Saltar al contenido</a>

	<div class="layout">
		<header class="sidebar">
			<div class="sidebar-inner">
				<a href="#top" class="brand">
					<TriangleMark class="brand-mark" />
				</a>

				<h1>{PERSON.fullName}</h1>
				<p class="role">{PERSON.jobTitle}</p>
				<p class="location">{PERSON.addressLocality}, Paraguay</p>

				<nav aria-label="Navegación principal">
					<ul>
						{
							NAV_LINKS.map((link) => (
								<li>
									<a href={link.href} data-nav-link>
										<span class="nav-line" aria-hidden="true" />
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
		</header>

		<main id="top" class="content">
			<div id="contenido">
				<section id="sobre-mi" aria-labelledby="sobre-mi-heading" class="reveal">
					<h2 id="sobre-mi-heading"><span class="section-num" aria-hidden="true">01</span>Sobre mí</h2>
					<p><!-- TODO: bio real --></p>
				</section>

				<section id="experiencia" aria-labelledby="experiencia-heading" class="reveal">
					<h2 id="experiencia-heading">
						<span class="section-num" aria-hidden="true">02</span>Experiencia
					</h2>
					<p><!-- TODO: experiencia laboral --></p>
				</section>

				<section id="certificaciones" aria-labelledby="certificaciones-heading" class="reveal">
					<h2 id="certificaciones-heading">
						<span class="section-num" aria-hidden="true">03</span>Certificaciones
					</h2>
					<p><!-- TODO: certificaciones --></p>
				</section>

				<section id="proyectos" aria-labelledby="proyectos-heading" class="reveal">
					<h2 id="proyectos-heading">
						<span class="section-num" aria-hidden="true">04</span>Proyectos
					</h2>
					<p><!-- TODO: proyectos destacados --></p>
				</section>

				<section id="contacto" aria-labelledby="contacto-heading" class="reveal">
					<h2 id="contacto-heading"><span class="section-num" aria-hidden="true">05</span>Contacto</h2>
					<p><!-- TODO: información de contacto --></p>
				</section>
			</div>

			<footer>
				<TriangleMark class="footer-mark" />
				<p>&copy; {new Date().getFullYear()} {SITE.name}</p>
			</footer>
		</main>
	</div>

	<script>
		import "../scripts/scroll-spy";
	</script>
</BaseLayout>
