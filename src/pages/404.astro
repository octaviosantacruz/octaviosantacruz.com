---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
	title="Page not found — Octavio Santacruz"
	description="The page you asked for does not exist. Return to Octavio Santacruz's portfolio."
	noindex
>
	<main class="wrap not-found" id="contenido">
		<a class="wordmark" href="/">Octavio Santacruz</a>
		<p class="kicker">404</p>
		<h1>This page is not here.</h1>
		<p class="support">The address may have changed, or it never existed. The portfolio is one click away.</p>
		<div class="actions">
			<a class="button button-primary" href="/">Back to the portfolio</a>
			<a class="button" href="/es/">Ver en español</a>
		</div>
	</main>
</BaseLayout>
